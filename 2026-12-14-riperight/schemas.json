{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/riperight.schema.json",
 "title": "RipeRight",
 "$defs": {
  "Person": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "age"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 1
    },
    "city_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "FruitPhoto": {
   "type": "object",
   "required": [
    "id",
    "fruit",
    "px_w",
    "px_h",
    "glare",
    "blur",
    "crop"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^p[0-9]{2}$"
    },
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "px_w": {
     "type": "integer",
     "minimum": 1
    },
    "px_h": {
     "type": "integer",
     "minimum": 1
    },
    "glare": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "blur": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "crop": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "ScanQuality": {
   "type": "object",
   "required": [
    "score",
    "ok",
    "tips_th"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "ok": {
     "type": "boolean"
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "FruitScan": {
   "type": "object",
   "required": [
    "photo_id",
    "fruit",
    "quality"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "quality": {
     "$ref": "#/$defs/ScanQuality"
    }
   },
   "additionalProperties": false
  },
  "AiCueExtract": {
   "type": "object",
   "required": [
    "fruit",
    "color",
    "spots",
    "confidence",
    "mold_seen"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "color": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "spots": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "mold_seen": {
     "type": "boolean"
    },
    "notes_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "RipenessInput": {
   "type": "object",
   "required": [
    "fruit",
    "color",
    "spots"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "color": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "spots": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "firmness": {
     "enum": [
      "hard",
      "firm",
      "yielding",
      "soft",
      "mushy"
     ]
    },
    "aroma": {
     "enum": [
      "none",
      "faint",
      "strong"
     ]
    },
    "knock": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "RipenessResult": {
   "type": "object",
   "required": [
    "fruit",
    "fruit_th",
    "index",
    "score",
    "stage",
    "stage_th",
    "ripens_after_pick",
    "days_to_perfect",
    "eat_within_days",
    "cues_used",
    "confidence",
    "headline_th",
    "disclaimer_th"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "fruit_th": {
     "type": "string"
    },
    "index": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "stage": {
     "enum": [
      "unripe",
      "almost",
      "perfect",
      "overripe"
     ]
    },
    "stage_th": {
     "type": "string"
    },
    "ripens_after_pick": {
     "type": "boolean"
    },
    "days_to_perfect": {
     "type": "integer",
     "minimum": 0
    },
    "eat_within_days": {
     "type": "integer",
     "minimum": 0
    },
    "cues_used": {
     "type": "array",
     "items": {
      "enum": [
       "color",
       "spots",
       "firmness",
       "aroma",
       "knock"
      ]
     },
     "minItems": 2
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "headline_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "KnockInput": {
   "type": "object",
   "required": [
    "fruit",
    "hz",
    "decay_ms"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "watermelon",
      "durian"
     ]
    },
    "hz": {
     "type": "number",
     "minimum": 30,
     "maximum": 600
    },
    "decay_ms": {
     "type": "number",
     "minimum": 10,
     "maximum": 2000
    }
   },
   "additionalProperties": false
  },
  "KnockResult": {
   "type": "object",
   "required": [
    "fruit",
    "hz",
    "decay_ms",
    "verdict",
    "verdict_th",
    "cue",
    "tip_th"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "watermelon",
      "durian"
     ]
    },
    "hz": {
     "type": "number"
    },
    "decay_ms": {
     "type": "number"
    },
    "verdict": {
     "enum": [
      "unripe",
      "almost",
      "ripe",
      "overripe"
     ]
    },
    "verdict_th": {
     "type": "string"
    },
    "cue": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "tip_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "PriceInput": {
   "type": "object",
   "required": [
    "fruit",
    "total_baht",
    "kg",
    "month"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "total_baht": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "kg": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "month": {
     "type": "integer",
     "minimum": 1,
     "maximum": 12
    }
   },
   "additionalProperties": false
  },
  "PriceCheck": {
   "type": "object",
   "required": [
    "fruit",
    "per_kg",
    "ref_low",
    "ref_high",
    "in_season",
    "verdict",
    "verdict_th",
    "diff_from_mid_pct",
    "disclaimer_th"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "per_kg": {
     "type": "number"
    },
    "ref_low": {
     "type": "integer",
     "minimum": 1
    },
    "ref_high": {
     "type": "integer",
     "minimum": 1
    },
    "in_season": {
     "type": "boolean"
    },
    "verdict": {
     "enum": [
      "suspicious_low",
      "cheap",
      "fair",
      "pricey",
      "very_pricey"
     ]
    },
    "verdict_th": {
     "type": "string"
    },
    "diff_from_mid_pct": {
     "type": "integer"
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "StoragePlan": {
   "type": "object",
   "required": [
    "fruit",
    "goal",
    "where",
    "speed_factor",
    "steps_th"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "goal": {
     "enum": [
      "speed_up",
      "keep",
      "slow_down"
     ]
    },
    "where": {
     "enum": [
      "counter",
      "paper_bag",
      "fridge"
     ]
    },
    "speed_factor": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "steps_th": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    }
   },
   "additionalProperties": false
  },
  "BasketItem": {
   "type": "object",
   "required": [
    "label",
    "fruit",
    "days_to_perfect",
    "eat_within_days"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "days_to_perfect": {
     "type": "integer",
     "minimum": 0
    },
    "eat_within_days": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "EatDay": {
   "type": "object",
   "required": [
    "date",
    "eat",
    "waiting",
    "past_best"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "eat": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "waiting": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "past_best": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "EatPlan": {
   "type": "object",
   "required": [
    "start",
    "days",
    "eat_first",
    "headline_th"
   ],
   "properties": {
    "start": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "days": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/EatDay"
     },
     "minItems": 1
    },
    "eat_first": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "PickCheck": {
   "type": "object",
   "required": [
    "fruit",
    "questions_th",
    "answers",
    "yes",
    "verdict",
    "verdict_th"
   ],
   "properties": {
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "questions_th": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 4,
     "maxItems": 4
    },
    "answers": {
     "type": "array",
     "items": {
      "type": "boolean"
     },
     "minItems": 4,
     "maxItems": 4
    },
    "yes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4
    },
    "verdict": {
     "enum": [
      "pick",
      "maybe",
      "skip"
     ]
    },
    "verdict_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "SeasonCalendar": {
   "type": "object",
   "required": [
    "month",
    "fruits",
    "fruits_th",
    "tip_th"
   ],
   "properties": {
    "month": {
     "type": "integer",
     "minimum": 1,
     "maximum": 12
    },
    "fruits": {
     "type": "array",
     "items": {
      "enum": [
       "durian",
       "mango",
       "avocado",
       "banana",
       "watermelon",
       "papaya",
       "pineapple",
       "mangosteen"
      ]
     }
    },
    "fruits_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "tip_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "DiaryEntry": {
   "type": "object",
   "required": [
    "date",
    "fruit",
    "predicted",
    "result",
    "paid_baht"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "predicted": {
     "enum": [
      "unripe",
      "almost",
      "perfect",
      "overripe"
     ]
    },
    "result": {
     "enum": [
      "just_right",
      "too_raw",
      "too_ripe"
     ]
    },
    "paid_baht": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "DiarySummary": {
   "type": "object",
   "required": [
    "count",
    "accuracy_pct",
    "spent_baht",
    "top_fruit",
    "headline_th"
   ],
   "properties": {
    "count": {
     "type": "integer",
     "minimum": 1
    },
    "accuracy_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "spent_baht": {
     "type": "integer",
     "minimum": 0
    },
    "top_fruit": {
     "enum": [
      "durian",
      "mango",
      "avocado",
      "banana",
      "watermelon",
      "papaya",
      "pineapple",
      "mangosteen"
     ]
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "title_th",
    "hook_th",
    "layout",
    "sizes",
    "watermark",
    "cta_th",
    "disclaimer_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "hook_th": {
     "type": "string"
    },
    "layout": {
     "enum": [
      "fruit_meter"
     ]
    },
    "sizes": {
     "type": "array",
     "items": {
      "enum": [
       "1080x1350",
       "1080x1920",
       "1080x1080"
      ]
     }
    },
    "watermark": {
     "type": "string"
    },
    "cta_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "allowed",
    "left_after",
    "paywall"
   ],
   "properties": {
    "allowed": {
     "type": "integer",
     "minimum": 0
    },
    "left_after": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "paywall": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "SafetyGuard": {
   "type": "object",
   "required": [
    "level",
    "message_th"
   ],
   "properties": {
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 }
}