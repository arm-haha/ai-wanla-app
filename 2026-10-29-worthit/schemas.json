{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "worthit.schemas.json",
 "title": "WorthIt schemas",
 "$defs": {
  "Profile": {
   "type": "object",
   "required": [
    "name",
    "monthly_income"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "monthly_income": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "work_days": {
     "type": "integer",
     "minimum": 1,
     "maximum": 31
    },
    "hours_per_day": {
     "type": "number",
     "exclusiveMinimum": 0,
     "maximum": 24
    },
    "jar_goal_thb": {
     "type": "number",
     "minimum": 0
    },
    "jar_goal_name_th": {
     "type": "string"
    }
   }
  },
  "Item": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "price_thb",
    "source"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string",
     "minLength": 1
    },
    "price_thb": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "category": {
     "enum": [
      "fashion",
      "sport",
      "food",
      "gadget",
      "beauty",
      "home",
      "other"
     ]
    },
    "source": {
     "enum": [
      "photo",
      "screenshot",
      "link",
      "manual"
     ]
    },
    "ocr_confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  },
  "VisionExtract": {
   "type": "object",
   "required": [
    "name_th",
    "price_thb",
    "confidence",
    "needs_confirm"
   ],
   "properties": {
    "name_th": {
     "type": "string"
    },
    "price_thb": {
     "type": [
      "number",
      "null"
     ]
    },
    "original_price_thb": {
     "type": [
      "number",
      "null"
     ]
    },
    "shop_hint": {
     "type": [
      "string",
      "null"
     ]
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "needs_confirm": {
     "type": "boolean"
    }
   }
  },
  "WorkTime": {
   "type": "object",
   "required": [
    "price_thb",
    "hourly_wage",
    "hours",
    "work_days",
    "pct_of_month",
    "label_th"
   ],
   "properties": {
    "price_thb": {
     "type": "number",
     "minimum": 0
    },
    "hourly_wage": {
     "type": "number",
     "minimum": 0
    },
    "hours": {
     "type": "number",
     "minimum": 0
    },
    "work_days": {
     "type": "number",
     "minimum": 0
    },
    "pct_of_month": {
     "type": "number",
     "minimum": 0
    },
    "label_th": {
     "type": "string"
    }
   }
  },
  "CostPerUse": {
   "type": "object",
   "required": [
    "total_uses",
    "per_use_thb",
    "tier"
   ],
   "properties": {
    "total_uses": {
     "type": "number",
     "minimum": 0
    },
    "per_use_thb": {
     "type": "number",
     "minimum": 0
    },
    "tier": {
     "enum": [
      "green",
      "amber",
      "red"
     ]
    }
   }
  },
  "Answers": {
   "type": "object",
   "required": [
    "need",
    "have_similar",
    "want_30d",
    "cash_ready",
    "sale_pressure"
   ],
   "properties": {
    "need": {
     "type": "boolean"
    },
    "have_similar": {
     "type": "boolean"
    },
    "want_30d": {
     "type": "boolean"
    },
    "cash_ready": {
     "type": "boolean"
    },
    "sale_pressure": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "Verdict": {
   "type": "object",
   "required": [
    "score",
    "verdict",
    "verdict_th"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "verdict": {
     "enum": [
      "buy",
      "wait",
      "skip"
     ]
    },
    "verdict_th": {
     "type": "string"
    }
   }
  },
  "CoolOff": {
   "type": "object",
   "required": [
    "ends_at",
    "hours_left",
    "unlocked"
   ],
   "properties": {
    "ends_at": {
     "type": "string",
     "format": "date-time"
    },
    "hours_left": {
     "type": "number",
     "minimum": 0
    },
    "unlocked": {
     "type": "boolean"
    }
   }
  },
  "SkipJar": {
   "type": "object",
   "required": [
    "saved_thb",
    "count",
    "goal_thb",
    "goal_pct",
    "reached"
   ],
   "properties": {
    "saved_thb": {
     "type": "number",
     "minimum": 0
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "goal_thb": {
     "type": "number",
     "minimum": 0
    },
    "goal_pct": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "reached": {
     "type": "boolean"
    }
   }
  },
  "MonthReport": {
   "type": "object",
   "required": [
    "bought",
    "skipped",
    "spent_thb",
    "saved_thb",
    "hours_saved",
    "biggest_skip"
   ],
   "properties": {
    "bought": {
     "type": "integer",
     "minimum": 0
    },
    "skipped": {
     "type": "integer",
     "minimum": 0
    },
    "spent_thb": {
     "type": "number",
     "minimum": 0
    },
    "saved_thb": {
     "type": "number",
     "minimum": 0
    },
    "hours_saved": {
     "type": "number",
     "minimum": 0
    },
    "biggest_skip": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "HabitCost": {
   "type": "object",
   "required": [
    "per_month_thb",
    "per_year_thb",
    "hours_per_month",
    "hours_per_year"
   ],
   "properties": {
    "per_month_thb": {
     "type": "number",
     "minimum": 0
    },
    "per_year_thb": {
     "type": "number",
     "minimum": 0
    },
    "hours_per_month": {
     "type": "number",
     "minimum": 0
    },
    "hours_per_year": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "DupeQuery": {
   "type": "object",
   "required": [
    "item_id",
    "search_terms_th",
    "note_th"
   ],
   "properties": {
    "item_id": {
     "type": "string"
    },
    "search_terms_th": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "maxItems": 5
    },
    "note_th": {
     "type": "string"
    }
   }
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "kind",
    "title_th",
    "big_stat",
    "sub_th"
   ],
   "properties": {
    "kind": {
     "enum": [
      "work_hours",
      "verdict",
      "skip_jar",
      "month_report",
      "cooloff_win"
     ]
    },
    "title_th": {
     "type": "string"
    },
    "big_stat": {
     "type": "string"
    },
    "sub_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   }
  }
 }
}