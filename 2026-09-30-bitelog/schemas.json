    "required": [
      "name",
      "ts"
    ],
    "properties": {
      "name": {
        "type": "string",
        "description": "ชื่ออีเวนต์มาตรฐาน",
        "enum": [
          "app_open",
          "scan_start",
          "scan_success",
          "scan_fail",
          "meal_confirm_open",
          "meal_logged",
          "library_search",
          "library_add",
          "favorite_add",
          "favorite_quick_add",
          "dashboard_view",
          "share_open",
          "share_success",
          "copy_caption",
          "water_add",
          "target_edit"
        ]
      },
      "ts": {
        "$ref": "#/definitions/IsoDateTime"
      },
      "props": {
        "type": "object",
        "description": "คุณสมบัติเพิ่ม เช่น scan_ms, source, meal_tag",
        "additionalProperties": true
      }
    }
  },
  "FeatureChecklistItem": {
    "type": "object",
    "description": "รายการยืนยันทีละฟีเจอร์ก่อนปล่อยคลิป",
