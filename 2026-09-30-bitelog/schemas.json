      },
      "locale": {
        "type": "string",
        "default": "th-TH"
      },
      "theme": {
        "type": "string",
        "enum": [
          "cream_coral",
          "system"
        ],
        "default": "cream_coral"
      }
    }
  },
  "LocalStore": {
    "type": "object",
    "description": "โครงข้อมูลทั้งก้อนใน localStorage key เช่น bitelog.v1",
    "additionalProperties": false,
    "properties": {
      "version": {
        "type": "integer",
        "minimum": 1,
        "default": 1
      },
      "settings": {
        "$ref": "#/UserSettings"
      },
      "favorites": {
        "type": "array",
        "items": {
          "$ref": "#/Favorite"
        }
      },
      "daily_logs": {
        "type": "array",
        "description": "ประวัติรายวันล่าสุด สูงสุดประมาณ 30 วัน",
        "items": {
          "$ref": "#/DailyLog"
        }
      },
      "recent_meal_ids": {
        "type": "array",
        "description": "เรียง id มื้อล่าสุดสำหรับ Quick Add",
        "items": {
          "type": "string"
        }
      },
      "streak": {
        "type": "object",
        "properties": {
          "current_days": {
            "type": "integer",
            "minimum": 0
          },
          "best_days": {
            "type": "integer",
            "minimum": 0
          },
          "last_active_date": {
            "$ref": "#/definitions/IsoDate"
          }
        }
      }
    }
  },
  "AnalyticsEvent": {
    "type": "object",
    "description": "อีเวนต์วัดพฤติกรรมฝั่ง client สำหรับช่องและผลิตภัณฑ์",
