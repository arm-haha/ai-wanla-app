      },
      "card": {
        "$ref": "#/ShareCard"
      },
      "card_filename": {
        "type": "string"
      },
      "mock_link": {
        "type": "string",
        "description": "ลิงก์ mock เช่น https://bitelog.app/d/{date}"
      },
      "include_streak": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "UserSettings": {
    "type": "object",
    "description": "ตั้งค่าเบาๆ ใน localStorage",
    "additionalProperties": false,
    "properties": {
      "display_name_th": {
        "type": "string",
        "description": "ชื่อเล่นบนการ์ดแชร์ (ออปชัน)"
