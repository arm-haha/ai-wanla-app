        "enum": [
          "must",
          "nice"
        ]
      },
      "implemented": {
        "type": "boolean"
      },
      "demo_in_reel": {
        "type": "boolean"
      },
      "notes": {
        "type": "string"
      }
    }
  },
  "FeatureChecklist": {
    "type": "object",
    "description": "ใช้ยืนยันกฎขั้นต่ำ ≥5 ฟีเจอร์ must ก่อนปล่อยคลิป AI วันละแอป",
    "additionalProperties": false,
    "required": [
      "app",
      "date",
      "features",
      "must_implemented_count"
