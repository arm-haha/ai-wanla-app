{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/arm-haha/ai-wanla-app/2026-12-24-dreamboard/schemas.json",
 "title": "DreamBoard",
 "$defs": {
  "User": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "name_en",
    "age",
    "city_th",
    "monthly_income"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 8,
     "maximum": 120
    },
    "city_th": {
     "type": "string"
    },
    "monthly_income": {
     "type": "number",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "Category": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "name_en",
    "color"
   ],
   "properties": {
    "key": {
     "enum": [
      "money",
      "health",
      "learn",
      "career",
      "travel",
      "family",
      "home",
      "habit",
      "mind",
      "hobby"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "color": {
     "type": "string",
     "pattern": "^#[0-9A-F]{6}$"
    }
   },
   "additionalProperties": false
  },
  "Unit": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "step",
    "max_per_month"
   ],
   "properties": {
    "key": {
     "enum": [
      "THB",
      "kg_loss",
      "km",
      "book",
      "trip",
      "times",
      "hours",
      "lesson"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "step": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "max_per_month": {
     "type": [
      "number",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "BoardTheme": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "palette"
   ],
   "properties": {
    "key": {
     "enum": [
      "pastel",
      "sunrise",
      "midnight",
      "thai_gold",
      "nature",
      "minimal"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "palette": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
     },
     "minItems": 6,
     "maxItems": 6
    }
   },
   "additionalProperties": false
  },
  "Device": {
   "type": "object",
   "required": [
    "key",
    "w",
    "h",
    "clock_zone",
    "bottom_zone"
   ],
   "properties": {
    "key": {
     "enum": [
      "iphone",
      "android",
      "desktop"
     ]
    },
    "w": {
     "type": "integer",
     "minimum": 1
    },
    "h": {
     "type": "integer",
     "minimum": 1
    },
    "clock_zone": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "bottom_zone": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "GoalText": {
   "type": "object",
   "required": [
    "text_th",
    "today"
   ],
   "properties": {
    "text_th": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "today": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
   },
   "additionalProperties": false
  },
  "AiGoalParse": {
   "type": "object",
   "required": [
    "title_th",
    "category",
    "unit",
    "start_value",
    "target_value",
    "deadline",
    "flags",
    "needs_clarification_th",
    "confidence"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "category": {
     "enum": [
      "money",
      "health",
      "learn",
      "career",
      "travel",
      "family",
      "home",
      "habit",
      "mind",
      "hobby"
     ]
    },
    "unit": {
     "enum": [
      "THB",
      "kg_loss",
      "km",
      "book",
      "trip",
      "times",
      "hours",
      "lesson",
      ""
     ]
    },
    "start_value": {
     "type": "number"
    },
    "target_value": {
     "type": "number"
    },
    "deadline": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "flags": {
     "type": "array",
     "items": {
      "enum": [
       "extreme_diet",
       "self_harm",
       "gambling",
       "get_rich_quick",
       "other_person",
       "medical",
       "minor",
       "photo_of_others"
      ]
     }
    },
    "needs_clarification_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "Goal": {
   "type": "object",
   "required": [
    "id",
    "title_th",
    "category",
    "category_th",
    "unit",
    "start_value",
    "target_value",
    "start",
    "deadline"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "title_th": {
     "type": "string"
    },
    "category": {
     "enum": [
      "money",
      "health",
      "learn",
      "career",
      "travel",
      "family",
      "home",
      "habit",
      "mind",
      "hobby"
     ]
    },
    "category_th": {
     "type": "string"
    },
    "unit": {
     "enum": [
      "THB",
      "kg_loss",
      "km",
      "book",
      "trip",
      "times",
      "hours",
      "lesson",
      ""
     ]
    },
    "start_value": {
     "type": "number"
    },
    "target_value": {
     "type": "number"
    },
    "start": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "deadline": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
   },
   "additionalProperties": false
  },
  "SmartCheck": {
   "type": "object",
   "required": [
    "score",
    "specific",
    "measurable",
    "achievable",
    "relevant",
    "timed",
    "per_month",
    "flag",
    "tips_th"
   ],
   "properties": {
    "score": {
     "enum": [
      0,
      20,
      40,
      60,
      80,
      100
     ]
    },
    "specific": {
     "type": "boolean"
    },
    "measurable": {
     "type": "boolean"
    },
    "achievable": {
     "type": "boolean"
    },
    "relevant": {
     "type": "boolean"
    },
    "timed": {
     "type": "boolean"
    },
    "per_month": {
     "type": [
      "number",
      "null"
     ]
    },
    "flag": {
     "enum": [
      null,
      "extreme_diet"
     ]
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "Milestone": {
   "type": "object",
   "required": [
    "month",
    "label_th",
    "target",
    "delta",
    "pct"
   ],
   "properties": {
    "month": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "label_th": {
     "type": "string"
    },
    "target": {
     "type": "number"
    },
    "delta": {
     "type": "number"
    },
    "pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    }
   },
   "additionalProperties": false
  },
  "Roadmap": {
   "type": "object",
   "required": [
    "goal_id",
    "months",
    "unit",
    "milestones"
   ],
   "properties": {
    "goal_id": {
     "type": "string"
    },
    "months": {
     "type": "integer",
     "minimum": 1,
     "maximum": 13
    },
    "unit": {
     "enum": [
      "THB",
      "kg_loss",
      "km",
      "book",
      "trip",
      "times",
      "hours",
      "lesson"
     ]
    },
    "milestones": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Milestone"
     },
     "minItems": 1
    }
   },
   "additionalProperties": false
  },
  "WeeklyHabit": {
   "type": "object",
   "required": [
    "goal_id",
    "weeks",
    "per_week",
    "unit",
    "text_th"
   ],
   "properties": {
    "goal_id": {
     "type": "string"
    },
    "weeks": {
     "type": "integer",
     "minimum": 1
    },
    "per_week": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "unit": {
     "enum": [
      "THB",
      "kg_loss",
      "km",
      "book",
      "trip",
      "times",
      "hours",
      "lesson"
     ]
    },
    "text_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Tile": {
   "type": "object",
   "required": [
    "goal_id",
    "x",
    "y",
    "w",
    "h",
    "color",
    "category"
   ],
   "properties": {
    "goal_id": {
     "type": "string"
    },
    "x": {
     "type": "integer",
     "minimum": 0
    },
    "y": {
     "type": "integer",
     "minimum": 0
    },
    "w": {
     "type": "integer",
     "minimum": 1
    },
    "h": {
     "type": "integer",
     "minimum": 1
    },
    "color": {
     "type": "string",
     "pattern": "^#[0-9A-F]{6}$"
    },
    "category": {
     "enum": [
      "money",
      "health",
      "learn",
      "career",
      "travel",
      "family",
      "home",
      "habit",
      "mind",
      "hobby"
     ]
    }
   },
   "additionalProperties": false
  },
  "BoardLayout": {
   "type": "object",
   "required": [
    "device",
    "theme",
    "w",
    "h",
    "safe_top",
    "safe_bottom",
    "tiles"
   ],
   "properties": {
    "device": {
     "enum": [
      "iphone",
      "android",
      "desktop"
     ]
    },
    "theme": {
     "enum": [
      "pastel",
      "sunrise",
      "midnight",
      "thai_gold",
      "nature",
      "minimal"
     ]
    },
    "w": {
     "type": "integer",
     "minimum": 1
    },
    "h": {
     "type": "integer",
     "minimum": 1
    },
    "safe_top": {
     "type": "integer",
     "minimum": 0
    },
    "safe_bottom": {
     "type": "integer",
     "minimum": 1
    },
    "tiles": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Tile"
     },
     "minItems": 1,
     "maxItems": 6
    }
   },
   "additionalProperties": false
  },
  "WordOfYear": {
   "type": "object",
   "required": [
    "category",
    "word_th",
    "word_en",
    "line_th"
   ],
   "properties": {
    "category": {
     "enum": [
      "money",
      "health",
      "learn",
      "career",
      "travel",
      "family",
      "home",
      "habit",
      "mind",
      "hobby"
     ]
    },
    "word_th": {
     "type": "string"
    },
    "word_en": {
     "type": "string"
    },
    "line_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Countdown": {
   "type": "object",
   "required": [
    "date",
    "days_to_new_year",
    "days_passed",
    "year_pct"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "days_to_new_year": {
     "type": "integer",
     "minimum": 1
    },
    "days_passed": {
     "type": "integer",
     "minimum": 0
    },
    "year_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    }
   },
   "additionalProperties": false
  },
  "LogEntry": {
   "type": "object",
   "required": [
    "date",
    "amount"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "amount": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   },
   "additionalProperties": false
  },
  "Streak": {
   "type": "object",
   "required": [
    "weeks",
    "this_week_done",
    "badge_th",
    "next_badge_at"
   ],
   "properties": {
    "weeks": {
     "type": "integer",
     "minimum": 0
    },
    "this_week_done": {
     "type": "boolean"
    },
    "badge_th": {
     "enum": [
      "เริ่มต้นแล้ว",
      "ครบไตรมาส",
      "ครึ่งปีไม่ทิ้งกัน",
      "ทั้งปีไม่ยอมแพ้",
      null
     ]
    },
    "next_badge_at": {
     "type": [
      "integer",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "Progress": {
   "type": "object",
   "required": [
    "goal_id",
    "done",
    "expected",
    "pct",
    "status",
    "glow",
    "message_th"
   ],
   "properties": {
    "goal_id": {
     "type": "string"
    },
    "done": {
     "type": "number",
     "minimum": 0
    },
    "expected": {
     "type": "number"
    },
    "pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "status": {
     "enum": [
      "done",
      "ahead",
      "on_track",
      "behind"
     ]
    },
    "glow": {
     "type": "integer",
     "minimum": 0,
     "maximum": 5
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "BoardGlow": {
   "type": "object",
   "required": [
    "overall_pct",
    "level",
    "lit_tiles",
    "tiles"
   ],
   "properties": {
    "overall_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "level": {
     "type": "integer",
     "minimum": 0,
     "maximum": 5
    },
    "lit_tiles": {
     "type": "integer",
     "minimum": 0
    },
    "tiles": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "goal_id",
       "glow"
      ],
      "properties": {
       "goal_id": {
        "type": "string"
       },
       "glow": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5
       }
      },
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": false
  },
  "Review": {
   "type": "object",
   "required": [
    "period",
    "title_th",
    "goals",
    "goals_done",
    "overall_pct",
    "best_goal_id",
    "best_title_th",
    "note_th"
   ],
   "properties": {
    "period": {
     "enum": [
      "mid_year",
      "year"
     ]
    },
    "title_th": {
     "type": "string"
    },
    "goals": {
     "type": "integer",
     "minimum": 1
    },
    "goals_done": {
     "type": "integer",
     "minimum": 0
    },
    "overall_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "best_goal_id": {
     "type": "string"
    },
    "best_title_th": {
     "type": "string"
    },
    "note_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "BuddyCard": {
   "type": "object",
   "required": [
    "owner_th",
    "buddy_th",
    "pact_th",
    "items",
    "private"
   ],
   "properties": {
    "owner_th": {
     "type": "string"
    },
    "buddy_th": {
     "type": "string"
    },
    "pact_th": {
     "type": "string"
    },
    "items": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "title_th",
       "amount_hidden"
      ],
      "properties": {
       "title_th": {
        "type": "string"
       },
       "amount_hidden": {
        "type": "boolean"
       }
      },
      "additionalProperties": false
     }
    },
    "private": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "kind",
    "size",
    "amounts_hidden_default",
    "faces_blurred",
    "glow_level",
    "word_th",
    "watermark"
   ],
   "properties": {
    "kind": {
     "enum": [
      "board",
      "progress",
      "review"
     ]
    },
    "size": {
     "const": "1080x1350"
    },
    "amounts_hidden_default": {
     "const": true
    },
    "faces_blurred": {
     "const": true
    },
    "glow_level": {
     "type": [
      "integer",
      "null"
     ]
    },
    "word_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "watermark": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ReelShot": {
   "type": "object",
   "required": [
    "kind",
    "start",
    "end",
    "caption_th"
   ],
   "properties": {
    "kind": {
     "enum": [
      "hook",
      "build",
      "type_goals",
      "board_reveal",
      "lockscreen",
      "glow_up",
      "cta"
     ]
    },
    "start": {
     "type": "number",
     "minimum": 0
    },
    "end": {
     "type": "number"
    },
    "caption_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ReelPlan": {
   "type": "object",
   "required": [
    "seconds",
    "ratio",
    "bpm",
    "shots",
    "watermark"
   ],
   "properties": {
    "seconds": {
     "type": "integer",
     "minimum": 15,
     "maximum": 30
    },
    "ratio": {
     "const": "9:16"
    },
    "bpm": {
     "type": "integer",
     "minimum": 1
    },
    "shots": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ReelShot"
     },
     "minItems": 3
    },
    "watermark": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "plan",
    "boards_per_day",
    "used",
    "left",
    "blocked"
   ],
   "properties": {
    "plan": {
     "enum": [
      "free",
      "plus"
     ]
    },
    "boards_per_day": {
     "type": "integer",
     "minimum": 1
    },
    "used": {
     "type": "integer",
     "minimum": 0
    },
    "left": {
     "type": "integer",
     "minimum": 0
    },
    "blocked": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "PrivacyCheck": {
   "type": "object",
   "required": [
    "allowed",
    "level",
    "flags",
    "messages_th",
    "share_allowed"
   ],
   "properties": {
    "allowed": {
     "type": "boolean"
    },
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "flags": {
     "type": "array",
     "items": {
      "enum": [
       "extreme_diet",
       "self_harm",
       "gambling",
       "get_rich_quick",
       "other_person",
       "medical",
       "minor",
       "photo_of_others"
      ]
     }
    },
    "messages_th": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "share_allowed": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "SafetyGuard": {
   "type": "object",
   "required": [
    "flag",
    "level",
    "message_th",
    "block"
   ],
   "properties": {
    "flag": {
     "type": [
      "string",
      "null"
     ]
    },
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "message_th": {
     "type": "string"
    },
    "block": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  }
 }
}