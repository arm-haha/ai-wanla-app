{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-wanla-app.local/scamscan/schemas.json",
  "title": "ScamScan schemas",
  "$defs": {
    "DateLocal": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "HexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "Channel": {
      "type": "string",
      "enum": [
        "sms",
        "line",
        "messenger",
        "email",
        "call",
        "other"
      ]
    },
    "RuleId": {
      "type": "string",
      "enum": [
        "urgency",
        "credential",
        "money",
        "too_good",
        "authority",
        "off_platform",
        "link",
        "brand_mismatch",
        "shortener",
        "bad_tld",
        "no_https",
        "punycode",
        "ip_link"
      ]
    },
    "LinkFlag": {
      "type": "string",
      "enum": [
        "brand_mismatch",
        "shortener",
        "bad_tld",
        "no_https",
        "punycode",
        "ip_link"
      ]
    },
    "BrandId": {
      "type": "string",
      "enum": [
        "kbank",
        "scb",
        "ktb",
        "krungsri",
        "bbl",
        "thaipost",
        "revenue",
        "pea"
      ]
    },
    "Level": {
      "type": "string",
      "enum": [
        "scam",
        "risky",
        "caution",
        "low"
      ],
      "description": "scam ≥75 · risky 50–74 · caution 25–49 · low 0–24"
    },
    "Truth": {
      "type": "string",
      "enum": [
        "scam",
        "real"
      ]
    },
    "ScanInput": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sender": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "source": {
          "type": "string",
          "enum": [
            "paste",
            "share_sheet",
            "screenshot_ocr",
            "demo"
          ]
        }
      },
      "required": [
        "text",
        "channel"
      ],
      "additionalProperties": false
    },
    "Rule": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RuleId"
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "label_th": {
          "type": "string"
        },
        "explain_th": {
          "type": "string"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "weight",
        "label_th",
        "explain_th",
        "patterns"
      ],
      "additionalProperties": false
    },
    "Brand": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/BrandId"
        },
        "name_th": {
          "type": "string"
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "host": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "official": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "verified": {
          "type": "boolean",
          "description": "set true only after checking the org's own site"
        }
      },
      "required": [
        "id",
        "name_th",
        "text",
        "host",
        "official",
        "verified"
      ],
      "additionalProperties": false
    },
    "Flag": {
      "type": "object",
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/RuleId"
        },
        "weight": {
          "type": "integer"
        },
        "label_th": {
          "type": "string"
        },
        "explain_th": {
          "type": "string"
        },
        "hits": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "rule_id",
        "weight",
        "label_th",
        "explain_th",
        "hits"
      ],
      "additionalProperties": false
    },
    "Highlight": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "rule_id": {
          "$ref": "#/$defs/RuleId"
        }
      },
      "required": [
        "start",
        "end",
        "text",
        "rule_id"
      ],
      "additionalProperties": false
    },
    "LinkXray": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "string"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https",
            "none"
          ]
        },
        "host": {
          "type": "string"
        },
        "registered_domain": {
          "type": "string"
        },
        "tld": {
          "type": "string"
        },
        "host_tokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claimed_brands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrandId"
          }
        },
        "official_match": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrandId"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LinkFlag"
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "official",
            "fake_lookalike",
            "hidden",
            "suspicious",
            "unknown"
          ]
        },
        "verdict_th": {
          "type": "string"
        },
        "real_site": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "raw",
        "scheme",
        "host",
        "registered_domain",
        "tld",
        "host_tokens",
        "claimed_brands",
        "official_match",
        "flags",
        "verdict",
        "verdict_th",
        "real_site"
      ],
      "additionalProperties": false
    },
    "ActionStep": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string"
        },
        "text_th": {
          "type": "string"
        }
      },
      "required": [
        "icon",
        "text_th"
      ],
      "additionalProperties": false
    },
    "ActionPlan": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionStep"
          },
          "minItems": 1
        },
        "safe_reply_th": {
          "type": [
            "string",
            "null"
          ]
        },
        "best_reply_th": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "steps",
        "safe_reply_th",
        "best_reply_th"
      ],
      "additionalProperties": false
    },
    "ScanResult": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "sender": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "raw_score": {
          "type": "integer",
          "minimum": 0
        },
        "combo_bonus": {
          "type": "integer",
          "enum": [
            0,
            10
          ]
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "label_th": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/HexColor"
        },
        "emoji": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Flag"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Highlight"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LinkXray"
          }
        },
        "claimed_brands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrandId"
          }
        },
        "actions": {
          "$ref": "#/$defs/ActionPlan"
        },
        "disclaimer_th": {
          "type": "string"
        }
      },
      "required": [
        "engine",
        "channel",
        "sender",
        "text",
        "score",
        "raw_score",
        "combo_bonus",
        "level",
        "label_th",
        "color",
        "emoji",
        "flags",
        "highlights",
        "links",
        "claimed_brands",
        "actions",
        "disclaimer_th"
      ],
      "additionalProperties": false
    },
    "FamilyCard": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "family_alert"
        },
        "size": {
          "type": "string",
          "enum": [
            "1080x1350",
            "1080x1920"
          ]
        },
        "to_th": {
          "type": "string"
        },
        "from_th": {
          "type": "string"
        },
        "title_th": {
          "type": "string"
        },
        "lines_th": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "accent": {
          "$ref": "#/$defs/HexColor"
        },
        "bg": {
          "$ref": "#/$defs/HexColor"
        },
        "footer": {
          "type": "string"
        },
        "line_text_th": {
          "type": "string",
          "description": "plain text for LINE share URL scheme"
        }
      },
      "required": [
        "kind",
        "size",
        "to_th",
        "from_th",
        "title_th",
        "lines_th",
        "accent",
        "bg",
        "footer",
        "line_text_th"
      ],
      "additionalProperties": false
    },
    "QuizCard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q\\d{2}$"
        },
        "truth": {
          "$ref": "#/$defs/Truth"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "sender": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "truth",
        "channel",
        "sender",
        "text"
      ],
      "additionalProperties": false
    },
    "QuizGrade": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "answer": {
                "$ref": "#/$defs/Truth"
              },
              "correct": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "answer",
              "correct"
            ],
            "additionalProperties": false
          }
        },
        "right": {
          "type": "integer"
        },
        "of": {
          "type": "integer"
        },
        "badge_th": {
          "type": "string"
        }
      },
      "required": [
        "results",
        "right",
        "of",
        "badge_th"
      ],
      "additionalProperties": false
    },
    "CallSign": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cs_"
        },
        "weight": {
          "type": "integer"
        },
        "label_th": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "weight",
        "label_th"
      ],
      "additionalProperties": false
    },
    "CallShield": {
      "type": "object",
      "properties": {
        "ticked": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^cs_"
          }
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "label_th": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/HexColor"
        },
        "emoji": {
          "type": "string"
        },
        "say_th": {
          "type": "string"
        },
        "rule_th": {
          "type": "string"
        }
      },
      "required": [
        "ticked",
        "score",
        "level",
        "label_th",
        "color",
        "emoji",
        "say_th",
        "rule_th"
      ],
      "additionalProperties": false
    },
    "HistoryEntry": {
      "type": "object",
      "properties": {
        "on": {
          "$ref": "#/$defs/DateLocal"
        },
        "score": {
          "type": "integer"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "top_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleId"
            },
            {
              "type": "null"
            }
          ]
        },
        "brands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrandId"
          }
        },
        "preview_th": {
          "type": "string",
          "maxLength": 40
        }
      },
      "required": [
        "on",
        "score",
        "level",
        "top_rule",
        "brands",
        "preview_th"
      ],
      "additionalProperties": false
    },
    "Wrapped": {
      "type": "object",
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "checked": {
          "type": "integer"
        },
        "flagged": {
          "type": "integer"
        },
        "low": {
          "type": "integer"
        },
        "top_rule_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleId"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_rule_th": {
          "type": [
            "string",
            "null"
          ]
        },
        "most_faked_brand": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrandId"
            },
            {
              "type": "null"
            }
          ]
        },
        "most_faked_brand_th": {
          "type": [
            "string",
            "null"
          ]
        },
        "quiz_streak_days": {
          "type": "integer"
        }
      },
      "required": [
        "month",
        "checked",
        "flagged",
        "low",
        "top_rule_id",
        "top_rule_th",
        "most_faked_brand",
        "most_faked_brand_th",
        "quiz_streak_days"
      ],
      "additionalProperties": false
    },
    "Settings": {
      "type": "object",
      "properties": {
        "big_text": {
          "type": "boolean"
        },
        "read_aloud": {
          "type": "boolean",
          "description": "Web Speech API th-TH"
        },
        "family": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name_th": {
                "type": "string"
              },
              "relation_th": {
                "type": "string"
              }
            },
            "required": [
              "name_th",
              "relation_th"
            ],
            "additionalProperties": false
          }
        },
        "share_history_with_family": {
          "type": "boolean"
        },
        "ai_explain": {
          "type": "boolean"
        }
      },
      "required": [
        "big_text",
        "read_aloud",
        "family",
        "share_history_with_family",
        "ai_explain"
      ],
      "additionalProperties": false
    },
    "LocalStore": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          },
          "maxItems": 500
        },
        "quiz_days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DateLocal"
          }
        },
        "custom_brands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Brand"
          }
        },
        "blocked_senders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "version",
        "settings",
        "history",
        "quiz_days"
      ],
      "additionalProperties": false
    },
    "AiExplainRequest": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "audience": {
          "type": "string",
          "enum": [
            "elder",
            "teen",
            "general"
          ]
        }
      },
      "required": [
        "text",
        "flags",
        "level",
        "audience"
      ],
      "additionalProperties": false
    },
    "AiExplainResponse": {
      "type": "object",
      "properties": {
        "summary_th": {
          "type": "string",
          "maxLength": 200
        },
        "why_th": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "never_change_score": {
          "const": true
        }
      },
      "required": [
        "summary_th",
        "why_th",
        "never_change_score"
      ],
      "additionalProperties": false
    },
    "AiOcrResponse": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "sender_guess": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel_guess": {
          "$ref": "#/$defs/Channel"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "text",
        "sender_guess",
        "channel_guess",
        "confidence"
      ],
      "additionalProperties": false
    }
  }
}