{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/singscore.schema.json",
 "title": "SingScore",
 "$defs": {
  "Person": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "age"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 1
    },
    "city_th": {
     "type": "string"
    },
    "goal_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Take": {
   "type": "object",
   "required": [
    "id",
    "exercise",
    "mean_cents_off",
    "mean_ms_off",
    "confidence",
    "notes"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "exercise": {
     "type": "string"
    },
    "mean_cents_off": {
     "type": "number",
     "minimum": 0
    },
    "mean_ms_off": {
     "type": "number",
     "minimum": 0
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "Score": {
   "type": "object",
   "required": [
    "ok",
    "pitch",
    "timing",
    "combined",
    "band",
    "cents",
    "ms",
    "exercise",
    "headline_th",
    "message_th",
    "disclaimer_th"
   ],
   "properties": {
    "ok": {
     "type": "boolean"
    },
    "pitch": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "timing": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "combined": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "band": {
     "type": [
      "string",
      "null"
     ]
    },
    "cents": {
     "type": "number",
     "minimum": 0
    },
    "ms": {
     "type": "number",
     "minimum": 0
    },
    "exercise": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "message_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "KeyFind": {
   "type": "object",
   "required": [
    "tonic",
    "mode",
    "exercise",
    "name_th",
    "notes",
    "headline_th",
    "source"
   ],
   "properties": {
    "tonic": {
     "type": "string"
    },
    "mode": {
     "type": "string"
    },
    "exercise": {
     "type": [
      "string",
      "null"
     ]
    },
    "name_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "headline_th": {
     "type": "string"
    },
    "source": {
     "enum": [
      "exercise",
      "notes"
     ]
    },
    "hit": {
     "type": "integer",
     "minimum": 0
    },
    "total": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "WarmupItem": {
   "type": "object",
   "required": [
    "key",
    "id",
    "name_th",
    "sec",
    "how_th"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "sec": {
     "type": "integer",
     "minimum": 1
    },
    "how_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "WarmupSet": {
   "type": "object",
   "required": [
    "items",
    "count",
    "total_sec",
    "headline_th",
    "disclaimer_th"
   ],
   "properties": {
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/WarmupItem"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "total_sec": {
     "type": "integer",
     "minimum": 0
    },
    "headline_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "DuetBattle": {
   "type": "object",
   "required": [
    "name_a",
    "score_a",
    "name_b",
    "score_b",
    "verdict",
    "winner",
    "margin",
    "headline_th",
    "disclaimer_th"
   ],
   "properties": {
    "name_a": {
     "type": "string"
    },
    "score_a": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "name_b": {
     "type": "string"
    },
    "score_b": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "verdict": {
     "enum": [
      "a",
      "b",
      "tie"
     ]
    },
    "winner": {
     "type": [
      "string",
      "null"
     ]
    },
    "margin": {
     "type": "integer",
     "minimum": 0
    },
    "headline_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "LogRow": {
   "type": "object",
   "required": [
    "date",
    "exercise",
    "name_th",
    "combined",
    "feeling"
   ],
   "properties": {
    "date": {
     "type": "string"
    },
    "exercise": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "combined": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "feeling": {
     "enum": [
      "easy",
      "ok",
      "hard",
      "stop"
     ]
    }
   },
   "additionalProperties": false
  },
  "PracticeLog": {
   "type": "object",
   "required": [
    "rows",
    "count",
    "best",
    "headline_th"
   ],
   "properties": {
    "rows": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/LogRow"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "best": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "title_th",
    "headline_th",
    "hook_th",
    "combined",
    "pitch",
    "timing",
    "key_th",
    "layout",
    "sizes",
    "watermark",
    "cta_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "hook_th": {
     "type": "string"
    },
    "combined": {
     "type": [
      "integer",
      "null"
     ]
    },
    "pitch": {
     "type": [
      "integer",
      "null"
     ]
    },
    "timing": {
     "type": [
      "integer",
      "null"
     ]
    },
    "key_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "layout": {
     "enum": [
      "sing_card"
     ]
    },
    "sizes": {
     "type": "array",
     "items": {
      "enum": [
       "1080x1350",
       "1080x1920",
       "1080x1080"
      ]
     }
    },
    "watermark": {
     "type": "string"
    },
    "cta_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "allowed",
    "left_after",
    "paywall"
   ],
   "properties": {
    "allowed": {
     "type": "integer",
     "minimum": 0
    },
    "left_after": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "paywall": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "SafetyGuard": {
   "type": "object",
   "required": [
    "level",
    "message_th"
   ],
   "properties": {
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ExerciseInfo": {
   "type": "object",
   "required": [
    "key",
    "id",
    "name_th",
    "name_en",
    "tonic",
    "mode",
    "notes"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "tonic": {
     "type": "string"
    },
    "mode": {
     "type": "string"
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  }
 }
}