{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/savequest.schema.json",
 "title": "SaveQuest",
 "$defs": {
  "Person": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "age",
    "goal_id",
    "goal_thb",
    "saved_thb"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 1
    },
    "city_th": {
     "type": "string"
    },
    "goal_id": {
     "enum": [
      "japan_trip",
      "emergency",
      "gadget",
      "wedding",
      "tuition",
      "down_payment",
      "concert"
     ]
    },
    "goal_th": {
     "type": "string"
    },
    "goal_thb": {
     "type": "integer",
     "minimum": 1
    },
    "saved_thb": {
     "type": "integer",
     "minimum": 0
    },
    "start": {
     "type": "string"
    },
    "deadline": {
     "type": "string"
    },
    "week": {
     "type": "integer",
     "minimum": 1
    },
    "base_thb": {
     "type": "integer",
     "minimum": 1
    },
    "seed": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "GoalPhoto": {
   "type": "object",
   "required": [
    "id",
    "px_w",
    "px_h",
    "glare",
    "blur",
    "crop",
    "goal_id"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^p[0-9]{2}$"
    },
    "px_w": {
     "type": "integer",
     "minimum": 1
    },
    "px_h": {
     "type": "integer",
     "minimum": 1
    },
    "glare": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "blur": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "crop": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "goal_id": {
     "enum": [
      "japan_trip",
      "emergency",
      "gadget",
      "wedding",
      "tuition",
      "down_payment",
      "concert"
     ]
    }
   },
   "additionalProperties": false
  },
  "ScanQuality": {
   "type": "object",
   "required": [
    "score",
    "ok",
    "tips_th"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "ok": {
     "type": "boolean"
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "PhotoScan": {
   "type": "object",
   "required": [
    "photo_id",
    "quality"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "quality": {
     "$ref": "#/$defs/ScanQuality"
    },
    "goal_id": {
     "enum": [
      "japan_trip",
      "emergency",
      "gadget",
      "wedding",
      "tuition",
      "down_payment",
      "concert"
     ]
    }
   },
   "additionalProperties": false
  },
  "Pipeline": {
   "type": "object",
   "required": [
    "photo_id",
    "steps"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "steps": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    }
   },
   "additionalProperties": false
  },
  "GoalInfo": {
   "type": "object",
   "required": [
    "id",
    "goal_id",
    "name_th",
    "name_en",
    "icon",
    "hint_th",
    "sample_thb"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^g[0-9]{2}$"
    },
    "goal_id": {
     "enum": [
      "japan_trip",
      "emergency",
      "gadget",
      "wedding",
      "tuition",
      "down_payment",
      "concert"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "icon": {
     "type": "string"
    },
    "hint_th": {
     "type": "string"
    },
    "sample_thb": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "JarFill": {
   "type": "object",
   "required": [
    "saved_thb",
    "goal_thb",
    "remaining_thb",
    "pct",
    "level",
    "label_th",
    "headline_th"
   ],
   "properties": {
    "saved_thb": {
     "type": "integer",
     "minimum": 0
    },
    "goal_thb": {
     "type": "integer",
     "minimum": 1
    },
    "remaining_thb": {
     "type": "integer",
     "minimum": 0
    },
    "pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "level": {
     "enum": [
      "empty",
      "growing",
      "halfway",
      "almost",
      "full"
     ]
    },
    "label_th": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Milestones": {
   "type": "object",
   "required": [
    "pct",
    "reached",
    "next_mark",
    "message_th"
   ],
   "properties": {
    "pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "reached": {
     "type": "array",
     "items": {
      "enum": [
       25,
       50,
       75,
       100
      ]
     }
    },
    "next_mark": {
     "type": [
      "integer",
      "null"
     ],
     "enum": [
      25,
      50,
      75,
      100,
      null
     ]
    },
    "next_amount_thb": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "need_thb": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Week52Plan": {
   "type": "object",
   "required": [
    "kind",
    "week",
    "base_thb",
    "amount_thb",
    "cumulative_thb",
    "plan_total_thb",
    "label_th"
   ],
   "properties": {
    "kind": {
     "const": "week52"
    },
    "week": {
     "type": "integer",
     "minimum": 1,
     "maximum": 52
    },
    "base_thb": {
     "type": "integer",
     "minimum": 1
    },
    "amount_thb": {
     "type": "integer",
     "minimum": 1
    },
    "cumulative_thb": {
     "type": "integer",
     "minimum": 0
    },
    "plan_total_thb": {
     "type": "integer",
     "minimum": 1
    },
    "label_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "RandomPlan": {
   "type": "object",
   "required": [
    "kind",
    "week",
    "base_thb",
    "seed",
    "multiplier",
    "amount_thb",
    "cumulative_thb",
    "plan_total_thb",
    "label_th"
   ],
   "properties": {
    "kind": {
     "const": "random"
    },
    "week": {
     "type": "integer",
     "minimum": 1,
     "maximum": 52
    },
    "base_thb": {
     "type": "integer",
     "minimum": 1
    },
    "seed": {
     "type": "string"
    },
    "multiplier": {
     "type": "integer",
     "minimum": 1,
     "maximum": 52
    },
    "amount_thb": {
     "type": "integer",
     "minimum": 1
    },
    "cumulative_thb": {
     "type": "integer",
     "minimum": 0
    },
    "plan_total_thb": {
     "type": "integer",
     "minimum": 1
    },
    "label_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Challenge": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "save_thb",
    "xp",
    "hint_th"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^c[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "save_thb": {
     "type": "integer",
     "minimum": 1
    },
    "xp": {
     "type": "integer",
     "minimum": 1
    },
    "hint_th": {
     "type": "string"
    },
    "date": {
     "type": "string"
    },
    "suggested": {
     "type": "boolean"
    },
    "challenge_id": {
     "enum": [
      "skip_cafe",
      "cook_home",
      "no_delivery",
      "walk_not_grab",
      "pack_water",
      "no_snack",
      "unsubscribe",
      "market_not_mall"
     ]
    }
   },
   "additionalProperties": false
  },
  "CompletedChallenge": {
   "type": "object",
   "required": [
    "id",
    "challenge_id",
    "name_th",
    "save_thb",
    "xp",
    "date",
    "done",
    "message_th"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "challenge_id": {
     "enum": [
      "skip_cafe",
      "cook_home",
      "no_delivery",
      "walk_not_grab",
      "pack_water",
      "no_snack",
      "unsubscribe",
      "market_not_mall"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "save_thb": {
     "type": "integer",
     "minimum": 1
    },
    "xp": {
     "type": "integer",
     "minimum": 1
    },
    "date": {
     "type": "string"
    },
    "done": {
     "type": "boolean"
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Streak": {
   "type": "object",
   "required": [
    "days",
    "frozen_used",
    "badge_th",
    "today_saved",
    "message_th"
   ],
   "properties": {
    "days": {
     "type": "integer",
     "minimum": 0
    },
    "frozen_used": {
     "type": "integer",
     "minimum": 0
    },
    "badge_th": {
     "type": "string"
    },
    "today_saved": {
     "type": "boolean"
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "RoundUp": {
   "type": "object",
   "required": [
    "amount_thb",
    "step_thb",
    "extra_thb",
    "rounded_thb"
   ],
   "properties": {
    "amount_thb": {
     "type": "integer",
     "minimum": 0
    },
    "step_thb": {
     "type": "integer",
     "minimum": 1
    },
    "extra_thb": {
     "type": "integer",
     "minimum": 0
    },
    "rounded_thb": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "TeamShare": {
   "type": "object",
   "required": [
    "name_th",
    "amount_thb",
    "pct"
   ],
   "properties": {
    "name_th": {
     "type": "string"
    },
    "amount_thb": {
     "type": "integer",
     "minimum": 0
    },
    "pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    }
   },
   "additionalProperties": false
  },
  "TeamJar": {
   "type": "object",
   "required": [
    "goal_thb",
    "saved_thb",
    "remaining_thb",
    "pct",
    "level",
    "members",
    "member_count",
    "headline_th"
   ],
   "properties": {
    "goal_thb": {
     "type": "integer",
     "minimum": 1
    },
    "saved_thb": {
     "type": "integer",
     "minimum": 0
    },
    "remaining_thb": {
     "type": "integer",
     "minimum": 0
    },
    "pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "level": {
     "enum": [
      "empty",
      "growing",
      "halfway",
      "almost",
      "full"
     ]
    },
    "members": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TeamShare"
     },
     "minItems": 1
    },
    "member_count": {
     "type": "integer",
     "minimum": 1
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "title_th",
    "headline_th",
    "hook_th",
    "pct",
    "streak_days",
    "layout",
    "sizes",
    "watermark",
    "cta_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "hook_th": {
     "type": "string"
    },
    "pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "streak_days": {
     "type": "integer",
     "minimum": 0
    },
    "layout": {
     "enum": [
      "jar_milestone"
     ]
    },
    "sizes": {
     "type": "array",
     "items": {
      "enum": [
       "1080x1350",
       "1080x1920",
       "1080x1080"
      ]
     }
    },
    "watermark": {
     "type": "string"
    },
    "cta_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "allowed",
    "left_after",
    "paywall"
   ],
   "properties": {
    "allowed": {
     "type": "integer",
     "minimum": 0
    },
    "left_after": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "paywall": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "SafetyGuard": {
   "type": "object",
   "required": [
    "level",
    "message_th"
   ],
   "properties": {
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 }
}