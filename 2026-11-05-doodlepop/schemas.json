{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/doodlepop.schema.json",
 "title": "DoodlePop",
 "$defs": {
  "Kid": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "birth",
    "avatar"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^k[0-9]{2,}$"
    },
    "name_th": {
     "type": "string"
    },
    "birth": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "avatar": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Drawing": {
   "type": "object",
   "required": [
    "id",
    "kid_id",
    "title_th",
    "subject",
    "drawn_on",
    "px_w",
    "px_h",
    "colors",
    "strokes",
    "parts",
    "scan"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^d[0-9]{2,}$"
    },
    "kid_id": {
     "type": "string"
    },
    "title_th": {
     "type": "string"
    },
    "subject": {
     "enum": [
      "animal",
      "person",
      "robot",
      "vehicle",
      "house",
      "monster",
      "plant",
      "other"
     ]
    },
    "drawn_on": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "px_w": {
     "type": "integer",
     "minimum": 1
    },
    "px_h": {
     "type": "integer",
     "minimum": 1
    },
    "colors": {
     "type": "integer",
     "minimum": 1,
     "maximum": 24
    },
    "strokes": {
     "type": "integer",
     "minimum": 0
    },
    "parts": {
     "type": "object",
     "required": [
      "head",
      "body",
      "arms",
      "legs",
      "tail",
      "wings"
     ],
     "properties": {
      "head": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "body": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "arms": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "legs": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "tail": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "wings": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      }
     },
     "additionalProperties": false
    },
    "scan": {
     "type": "object",
     "required": [
      "shadow",
      "blur",
      "tilt",
      "crop_cut"
     ],
     "properties": {
      "shadow": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "blur": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "tilt": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "crop_cut": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "ScanExtract": {
   "type": "object",
   "required": [
    "drawing_found",
    "corners",
    "scan",
    "subject",
    "title_guess_th",
    "parts",
    "colors",
    "has_child_face",
    "has_text",
    "retake_reason_th"
   ],
   "properties": {
    "drawing_found": {
     "type": "boolean"
    },
    "corners": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "minItems": 4,
     "maxItems": 4
    },
    "scan": {
     "type": "object",
     "required": [
      "shadow",
      "blur",
      "tilt",
      "crop_cut"
     ],
     "properties": {
      "shadow": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "blur": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "tilt": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "crop_cut": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      }
     },
     "additionalProperties": false
    },
    "subject": {
     "enum": [
      "animal",
      "person",
      "robot",
      "vehicle",
      "house",
      "monster",
      "plant",
      "other"
     ]
    },
    "title_guess_th": {
     "type": "string"
    },
    "parts": {
     "type": "object",
     "required": [
      "head",
      "body",
      "arms",
      "legs",
      "tail",
      "wings"
     ],
     "properties": {
      "head": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "body": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "arms": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "legs": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "tail": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      },
      "wings": {
       "type": "integer",
       "minimum": 0,
       "maximum": 8
      }
     },
     "additionalProperties": false
    },
    "colors": {
     "type": "integer",
     "minimum": 0
    },
    "has_child_face": {
     "type": "boolean"
    },
    "has_text": {
     "type": "boolean"
    },
    "retake_reason_th": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "ScanReport": {
   "type": "object",
   "required": [
    "drawing_id",
    "score",
    "level",
    "level_th",
    "steps",
    "retake_reason_th"
   ],
   "properties": {
    "drawing_id": {
     "type": "string"
    },
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "level": {
     "enum": [
      "retake",
      "ok",
      "great"
     ]
    },
    "level_th": {
     "type": "string"
    },
    "steps": {
     "type": "array",
     "items": {
      "enum": [
       "perspective",
       "deshadow",
       "remove_paper",
       "sharpen_lines",
       "fill_gaps",
       "cutout"
      ]
     },
     "uniqueItems": true
    },
    "retake_reason_th": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "Rig": {
   "type": "object",
   "required": [
    "drawing_id",
    "bones",
    "presets",
    "fallbacks",
    "needs_manual_pins"
   ],
   "properties": {
    "drawing_id": {
     "type": "string"
    },
    "bones": {
     "type": "integer",
     "minimum": 0
    },
    "presets": {
     "type": "array",
     "items": {
      "enum": [
       "wave",
       "jump",
       "dance",
       "walk",
       "spin",
       "sleep",
       "hop",
       "wiggle"
      ]
     },
     "minItems": 6,
     "maxItems": 6
    },
    "fallbacks": {
     "type": "object",
     "propertyNames": {
      "enum": [
       "wave",
       "walk"
      ]
     },
     "additionalProperties": {
      "enum": [
       "wave",
       "jump",
       "dance",
       "walk",
       "spin",
       "sleep",
       "hop",
       "wiggle"
      ]
     }
    },
    "needs_manual_pins": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "AnimationClip": {
   "type": "object",
   "required": [
    "preset",
    "label_th",
    "duration_s",
    "fps",
    "frames",
    "loop"
   ],
   "properties": {
    "preset": {
     "enum": [
      "wave",
      "jump",
      "dance",
      "walk",
      "spin",
      "sleep",
      "hop",
      "wiggle"
     ]
    },
    "label_th": {
     "type": "string"
    },
    "duration_s": {
     "type": "number",
     "minimum": 0
    },
    "fps": {
     "enum": [
      12,
      24,
      30
     ]
    },
    "frames": {
     "type": "integer",
     "minimum": 1
    },
    "loop": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "ExportSpec": {
   "type": "object",
   "required": [
    "format",
    "w",
    "h",
    "fps",
    "duration_s",
    "loops",
    "frames",
    "music",
    "watermark"
   ],
   "properties": {
    "format": {
     "enum": [
      "reel_mp4",
      "square_mp4",
      "gif"
     ]
    },
    "w": {
     "type": "integer",
     "minimum": 1
    },
    "h": {
     "type": "integer",
     "minimum": 1
    },
    "fps": {
     "type": "integer",
     "minimum": 1
    },
    "duration_s": {
     "type": "number",
     "minimum": 0
    },
    "loops": {
     "type": "integer",
     "minimum": 1
    },
    "frames": {
     "type": "integer",
     "minimum": 1
    },
    "music": {
     "type": "boolean"
    },
    "watermark": {
     "const": "Made with DoodlePop"
    }
   },
   "additionalProperties": false
  },
  "Story": {
   "type": "object",
   "required": [
    "kid_id",
    "characters",
    "title_th",
    "age",
    "plan",
    "pages",
    "tts_voice",
    "safety"
   ],
   "properties": {
    "kid_id": {
     "type": "string"
    },
    "characters": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "maxItems": 3
    },
    "title_th": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 2,
     "maximum": 12
    },
    "plan": {
     "type": "object",
     "required": [
      "pages",
      "words_per_page",
      "total_words",
      "narration_s"
     ],
     "properties": {
      "pages": {
       "type": "integer",
       "minimum": 4,
       "maximum": 6
      },
      "words_per_page": {
       "type": "integer",
       "minimum": 1
      },
      "total_words": {
       "type": "integer",
       "minimum": 1
      },
      "narration_s": {
       "type": "integer",
       "minimum": 0
      }
     },
     "additionalProperties": false
    },
    "pages": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "n",
       "text_th",
       "drawing_ids",
       "pose"
      ],
      "properties": {
       "n": {
        "type": "integer",
        "minimum": 1
       },
       "text_th": {
        "type": "string"
       },
       "drawing_ids": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "minItems": 1
       },
       "pose": {
        "enum": [
         "wave",
         "jump",
         "dance",
         "walk",
         "spin",
         "sleep",
         "hop",
         "wiggle"
        ]
       }
      },
      "additionalProperties": false
     },
     "minItems": 4,
     "maxItems": 6
    },
    "tts_voice": {
     "enum": [
      "th_female_warm",
      "th_male_warm",
      "parent_recorded"
     ]
    },
    "safety": {
     "type": "object",
     "required": [
      "no_scary",
      "no_brands",
      "ends_calm"
     ],
     "properties": {
      "no_scary": {
       "type": "boolean"
      },
      "no_brands": {
       "type": "boolean"
      },
      "ends_calm": {
       "type": "boolean"
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "YearRecap": {
   "type": "object",
   "required": [
    "kid_id",
    "year",
    "count",
    "top_subject",
    "avg_colors",
    "first_detail",
    "last_detail",
    "growth_pct",
    "headline_th"
   ],
   "properties": {
    "kid_id": {
     "type": "string"
    },
    "year": {
     "type": "integer",
     "minimum": 2000
    },
    "count": {
     "type": "integer",
     "minimum": 1
    },
    "top_subject": {
     "enum": [
      "animal",
      "person",
      "robot",
      "vehicle",
      "house",
      "monster",
      "plant",
      "other"
     ]
    },
    "avg_colors": {
     "type": "number",
     "minimum": 0
    },
    "first_detail": {
     "type": "integer",
     "minimum": 0
    },
    "last_detail": {
     "type": "integer",
     "minimum": 0
    },
    "growth_pct": {
     "type": [
      "integer",
      "null"
     ]
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "StickerPack": {
   "type": "object",
   "required": [
    "title_th",
    "count",
    "size",
    "stickers"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "count": {
     "enum": [
      8,
      16,
      24,
      32,
      40
     ]
    },
    "size": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "stickers": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "drawing_id",
       "preset",
       "text_th"
      ],
      "properties": {
       "drawing_id": {
        "type": "string"
       },
       "preset": {
        "enum": [
         "wave",
         "jump",
         "dance",
         "walk",
         "spin",
         "sleep",
         "hop",
         "wiggle"
        ]
       },
       "text_th": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "minItems": 8,
     "maxItems": 40
    }
   },
   "additionalProperties": false
  },
  "ColoringPage": {
   "type": "object",
   "required": [
    "drawing_id",
    "age",
    "line_px",
    "paper",
    "regions"
   ],
   "properties": {
    "drawing_id": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 2,
     "maximum": 12
    },
    "line_px": {
     "enum": [
      4,
      6,
      8
     ]
    },
    "paper": {
     "enum": [
      "A4",
      "A5"
     ]
    },
    "regions": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "DrawPrompt": {
   "type": "object",
   "required": [
    "date",
    "prompt_th",
    "repeat_window_days"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "prompt_th": {
     "enum": [
      "สัตว์ที่มีขา 6 ขา",
      "บ้านในฝันของหนู",
      "ไดโนเสาร์ใส่หมวก",
      "หุ่นยนต์ช่วยแม่ทำกับข้าว",
      "ปลาที่บินได้",
      "เพื่อนจากดาวอังคาร",
      "ช้างกินไอศกรีม",
      "รถที่วิ่งบนเมฆ",
      "แมวเป็นซูเปอร์ฮีโร่",
      "ต้นไม้ที่ออกผลเป็นขนม",
      "มังกรตัวจิ๋ว",
      "ครอบครัวของหนูเป็นสัตว์"
     ]
    },
    "repeat_window_days": {
     "const": 30
    }
   },
   "additionalProperties": false
  },
  "ShareLink": {
   "type": "object",
   "required": [
    "expires_on",
    "view_only",
    "allow_download",
    "strip_location",
    "indexable"
   ],
   "properties": {
    "expires_on": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "view_only": {
     "type": "boolean"
    },
    "allow_download": {
     "type": "boolean"
    },
    "strip_location": {
     "const": true
    },
    "indexable": {
     "const": false
    }
   },
   "additionalProperties": false
  },
  "PrintCheck": {
   "type": "object",
   "required": [
    "product",
    "dpi",
    "need_dpi",
    "ok"
   ],
   "properties": {
    "product": {
     "enum": [
      "mug",
      "tshirt",
      "poster_a4",
      "sticker_7cm"
     ]
    },
    "dpi": {
     "type": "integer",
     "minimum": 0
    },
    "need_dpi": {
     "type": "integer",
     "minimum": 1
    },
    "ok": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "ParentGate": {
   "type": "object",
   "required": [
    "action",
    "needs_parent",
    "allowed"
   ],
   "properties": {
    "action": {
     "enum": [
      "animate",
      "color",
      "delete_drawing",
      "draw_prompt",
      "export_video",
      "gallery_view",
      "grandparent_link",
      "print_order",
      "share_public",
      "story"
     ]
    },
    "needs_parent": {
     "type": "boolean"
    },
    "allowed": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "kind",
    "allowed",
    "left_after",
    "paywall"
   ],
   "properties": {
    "kind": {
     "enum": [
      "animate",
      "story"
     ]
    },
    "allowed": {
     "type": "integer",
     "minimum": 0
    },
    "left_after": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "paywall": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "title_th",
    "headline_th",
    "preset",
    "watermark",
    "cta_th",
    "shows_child_face"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "preset": {
     "enum": [
      "wave",
      "jump",
      "dance",
      "walk",
      "spin",
      "sleep",
      "hop",
      "wiggle"
     ]
    },
    "watermark": {
     "const": "Made with DoodlePop"
    },
    "cta_th": {
     "type": "string"
    },
    "shows_child_face": {
     "const": false
    }
   },
   "additionalProperties": false
  }
 }
}