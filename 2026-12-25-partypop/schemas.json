{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/arm-haha/ai-wanla-app/2026-12-25-partypop/schemas.json",
 "title": "PartyPop",
 "$defs": {
  "User": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "name_en",
    "age",
    "city_th"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 8,
     "maximum": 120
    },
    "city_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Theme": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "name_en",
    "palette",
    "dress_th"
   ],
   "properties": {
    "key": {
     "enum": [
      "countdown_gold",
      "cozy_xmas",
      "pastel_pop",
      "thai_fair",
      "neon_disco",
      "minimal_white"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "palette": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
     },
     "minItems": 6,
     "maxItems": 6
    },
    "dress_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "DecorItem": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "zone",
    "price",
    "pack_th",
    "priority",
    "themes",
    "qty_rule"
   ],
   "properties": {
    "key": {
     "enum": [
      "garland",
      "balloons",
      "lights",
      "backdrop",
      "number_balloons",
      "tablecloth",
      "hats",
      "props",
      "led_candles",
      "mini_tree",
      "paper_lanterns",
      "disco_ball"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "zone": {
     "enum": [
      "ceiling",
      "floor",
      "guest",
      "photo",
      "table",
      "wall"
     ]
    },
    "price": {
     "type": "integer",
     "minimum": 1
    },
    "pack_th": {
     "type": "string"
    },
    "priority": {
     "type": "integer",
     "minimum": 1
    },
    "themes": {
     "type": "array",
     "items": {
      "enum": [
       "countdown_gold",
       "cozy_xmas",
       "pastel_pop",
       "thai_fair",
       "neon_disco",
       "minimal_white"
      ]
     },
     "minItems": 1
    },
    "qty_rule": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "AiRoomScan": {
   "type": "object",
   "required": [
    "room_type",
    "width_m",
    "depth_m",
    "tables",
    "has_balcony",
    "rental",
    "zones",
    "light",
    "clutter",
    "confidence"
   ],
   "properties": {
    "room_type": {
     "enum": [
      "living",
      "studio",
      "office",
      "dining",
      "garden",
      "rooftop"
     ]
    },
    "width_m": {
     "type": "number",
     "minimum": 1.5,
     "maximum": 20
    },
    "depth_m": {
     "type": "number",
     "minimum": 1.5,
     "maximum": 20
    },
    "tables": {
     "type": "integer",
     "minimum": 0
    },
    "has_balcony": {
     "type": "boolean"
    },
    "rental": {
     "type": "boolean"
    },
    "zones": {
     "type": "array",
     "items": {
      "enum": [
       "wall",
       "sofa",
       "table",
       "window",
       "ceiling",
       "bed",
       "floor"
      ]
     }
    },
    "light": {
     "enum": [
      "warm",
      "cool",
      "dim"
     ]
    },
    "clutter": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "Room": {
   "type": "object",
   "required": [
    "room_type",
    "width_m",
    "depth_m",
    "area_m2",
    "wall_m",
    "tables",
    "has_balcony",
    "rental"
   ],
   "properties": {
    "room_type": {
     "type": "string"
    },
    "width_m": {
     "type": "number",
     "minimum": 0
    },
    "depth_m": {
     "type": "number",
     "minimum": 0
    },
    "area_m2": {
     "type": "number",
     "minimum": 0
    },
    "wall_m": {
     "type": "number",
     "minimum": 0
    },
    "tables": {
     "type": "integer",
     "minimum": 1
    },
    "has_balcony": {
     "type": "boolean"
    },
    "rental": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "Capacity": {
   "type": "object",
   "required": [
    "guests",
    "seated_max",
    "standing_max",
    "status",
    "exit_path_cm",
    "tip_th",
    "flag"
   ],
   "properties": {
    "guests": {
     "type": "integer",
     "minimum": 1
    },
    "seated_max": {
     "type": "integer",
     "minimum": 0
    },
    "standing_max": {
     "type": "integer",
     "minimum": 0
    },
    "status": {
     "enum": [
      "comfy",
      "mingle",
      "over"
     ]
    },
    "exit_path_cm": {
     "const": 80
    },
    "tip_th": {
     "type": "string"
    },
    "flag": {
     "enum": [
      null,
      "over_capacity"
     ]
    }
   },
   "additionalProperties": false
  },
  "BudgetSplit": {
   "type": "object",
   "required": [
    "total",
    "decor",
    "food",
    "drinks",
    "games_gifts",
    "reserve",
    "per_head",
    "food_per_guest",
    "potluck",
    "tip_th"
   ],
   "properties": {
    "total": {
     "type": "integer",
     "minimum": 1
    },
    "decor": {
     "type": "integer",
     "minimum": 0
    },
    "food": {
     "type": "integer",
     "minimum": 0
    },
    "drinks": {
     "type": "integer",
     "minimum": 0
    },
    "games_gifts": {
     "type": "integer",
     "minimum": 0
    },
    "reserve": {
     "type": "integer",
     "minimum": 0
    },
    "per_head": {
     "type": "integer",
     "minimum": 0
    },
    "food_per_guest": {
     "type": "number",
     "minimum": 0
    },
    "potluck": {
     "type": "boolean"
    },
    "tip_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "DecoPick": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "zone",
    "packs",
    "pack_th",
    "unit_price",
    "cost",
    "no_nails"
   ],
   "properties": {
    "key": {
     "enum": [
      "garland",
      "balloons",
      "lights",
      "backdrop",
      "number_balloons",
      "tablecloth",
      "hats",
      "props",
      "led_candles",
      "mini_tree",
      "paper_lanterns",
      "disco_ball"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "zone": {
     "enum": [
      "ceiling",
      "floor",
      "guest",
      "photo",
      "table",
      "wall"
     ]
    },
    "packs": {
     "type": "integer",
     "minimum": 1
    },
    "pack_th": {
     "type": "string"
    },
    "unit_price": {
     "type": "integer",
     "minimum": 1
    },
    "cost": {
     "type": "integer",
     "minimum": 1
    },
    "no_nails": {
     "const": true
    }
   },
   "additionalProperties": false
  },
  "DecoPlan": {
   "type": "object",
   "required": [
    "theme",
    "theme_th",
    "budget",
    "spent",
    "left",
    "items",
    "skipped",
    "zones",
    "palette"
   ],
   "properties": {
    "theme": {
     "enum": [
      "countdown_gold",
      "cozy_xmas",
      "pastel_pop",
      "thai_fair",
      "neon_disco",
      "minimal_white"
     ]
    },
    "theme_th": {
     "type": "string"
    },
    "budget": {
     "type": "integer",
     "minimum": 0
    },
    "spent": {
     "type": "integer",
     "minimum": 0
    },
    "left": {
     "type": "integer",
     "minimum": 0
    },
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/DecoPick"
     }
    },
    "skipped": {
     "type": "array",
     "items": {
      "enum": [
       "garland",
       "balloons",
       "lights",
       "backdrop",
       "number_balloons",
       "tablecloth",
       "hats",
       "props",
       "led_candles",
       "mini_tree",
       "paper_lanterns",
       "disco_ball"
      ]
     }
    },
    "zones": {
     "type": "array",
     "items": {
      "enum": [
       "ceiling",
       "floor",
       "guest",
       "photo",
       "table",
       "wall"
      ]
     }
    },
    "palette": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
     },
     "minItems": 6,
     "maxItems": 6
    }
   },
   "additionalProperties": false
  },
  "RenderPrompt": {
   "type": "object",
   "required": [
    "keep_layout",
    "theme",
    "palette",
    "items_th",
    "forbid",
    "size"
   ],
   "properties": {
    "keep_layout": {
     "const": true
    },
    "theme": {
     "enum": [
      "countdown_gold",
      "cozy_xmas",
      "pastel_pop",
      "thai_fair",
      "neon_disco",
      "minimal_white"
     ]
    },
    "palette": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
     }
    },
    "items_th": {
     "type": "string"
    },
    "forbid": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 4
    },
    "size": {
     "const": "1080x1350"
    }
   },
   "additionalProperties": false
  },
  "MenuItem": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "need",
    "unit",
    "buy_qty",
    "packs",
    "cost",
    "section_th"
   ],
   "properties": {
    "key": {
     "enum": [
      "meat",
      "seafood",
      "veg",
      "noodle",
      "rice",
      "sauce",
      "snack",
      "fruit",
      "dessert",
      "drink",
      "water",
      "ice",
      "chicken_dish"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "need": {
     "type": "number",
     "minimum": 0
    },
    "unit": {
     "type": "string"
    },
    "buy_qty": {
     "type": "number",
     "minimum": 0
    },
    "packs": {
     "type": "integer",
     "minimum": 1
    },
    "cost": {
     "type": "integer",
     "minimum": 0
    },
    "section_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "MenuPlan": {
   "type": "object",
   "required": [
    "style",
    "style_th",
    "adults",
    "kids",
    "hours",
    "guest_eq",
    "items",
    "total",
    "allergy_labels",
    "flag"
   ],
   "properties": {
    "style": {
     "enum": [
      "suki",
      "buffet",
      "snack"
     ]
    },
    "style_th": {
     "type": "string"
    },
    "adults": {
     "type": "integer",
     "minimum": 1
    },
    "kids": {
     "type": "integer",
     "minimum": 0
    },
    "hours": {
     "type": "number",
     "minimum": 1,
     "maximum": 12
    },
    "guest_eq": {
     "type": "number",
     "minimum": 0
    },
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/MenuItem"
     },
     "minItems": 1
    },
    "total": {
     "type": "integer",
     "minimum": 0
    },
    "allergy_labels": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "flag": {
     "enum": [
      null,
      "food_allergy"
     ]
    }
   },
   "additionalProperties": false
  },
  "MenuTrim": {
   "type": "object",
   "required": [
    "style",
    "total",
    "potluck_dishes",
    "changed"
   ],
   "properties": {
    "style": {
     "enum": [
      "suki",
      "buffet",
      "snack"
     ]
    },
    "total": {
     "type": "integer",
     "minimum": 0
    },
    "potluck_dishes": {
     "type": "integer",
     "minimum": 0
    },
    "changed": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "ShoppingList": {
   "type": "object",
   "required": [
    "rows",
    "sections",
    "total",
    "budget",
    "over_by",
    "fits"
   ],
   "properties": {
    "rows": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name_th",
       "qty_th",
       "section_th",
       "cost",
       "checked"
      ],
      "properties": {
       "name_th": {
        "type": "string"
       },
       "qty_th": {
        "type": "string"
       },
       "section_th": {
        "type": "string"
       },
       "cost": {
        "type": "integer",
        "minimum": 0
       },
       "checked": {
        "type": "boolean"
       }
      },
      "additionalProperties": false
     },
     "minItems": 1
    },
    "sections": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "section_th",
       "cost"
      ],
      "properties": {
       "section_th": {
        "type": "string"
       },
       "cost": {
        "type": "integer",
        "minimum": 0
       }
      },
      "additionalProperties": false
     }
    },
    "total": {
     "type": "integer",
     "minimum": 0
    },
    "budget": {
     "type": "integer",
     "minimum": 1
    },
    "over_by": {
     "type": "integer",
     "minimum": 0
    },
    "fits": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "Timeline": {
   "type": "object",
   "required": [
    "start",
    "end",
    "tasks",
    "flag"
   ],
   "properties": {
    "start": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
    },
    "end": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
    },
    "tasks": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "at",
       "text_th",
       "done"
      ],
      "properties": {
       "key": {
        "enum": [
         "invite",
         "rsvp",
         "shop",
         "decorate",
         "fresh",
         "table",
         "test",
         "welcome",
         "games",
         "countdown",
         "gift_swap",
         "home"
        ]
       },
       "at": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
       },
       "text_th": {
        "type": "string"
       },
       "done": {
        "type": "boolean"
       }
      },
      "additionalProperties": false
     },
     "minItems": 3
    },
    "flag": {
     "enum": [
      null,
      "noise_late"
     ]
    }
   },
   "additionalProperties": false
  },
  "GamePlan": {
   "type": "object",
   "required": [
    "players",
    "mode",
    "kids",
    "minutes",
    "games",
    "drinking_games"
   ],
   "properties": {
    "players": {
     "type": "integer",
     "minimum": 1
    },
    "mode": {
     "enum": [
      "family",
      "office",
      "friends"
     ]
    },
    "kids": {
     "type": "integer",
     "minimum": 0
    },
    "minutes": {
     "type": "integer",
     "minimum": 0
    },
    "games": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "name_th",
       "minutes",
       "props_th",
       "kid_ok"
      ],
      "properties": {
       "key": {
        "enum": [
         "bingo",
         "charades",
         "pass_parcel",
         "musical_chairs",
         "year_quiz",
         "who_said",
         "balloon_pop",
         "draw_guess",
         "photo_hunt",
         "lucky_draw"
        ]
       },
       "name_th": {
        "type": "string"
       },
       "minutes": {
        "type": "integer",
        "minimum": 1
       },
       "props_th": {
        "type": "string"
       },
       "kid_ok": {
        "type": "boolean"
       }
      },
      "additionalProperties": false
     }
    },
    "drinking_games": {
     "const": false
    }
   },
   "additionalProperties": false
  },
  "GiftSwap": {
   "type": "object",
   "required": [
    "people",
    "seed",
    "budget_cap",
    "pairs",
    "secret",
    "rule_th"
   ],
   "properties": {
    "people": {
     "type": "integer",
     "minimum": 3
    },
    "seed": {
     "type": "integer"
    },
    "budget_cap": {
     "type": "integer",
     "minimum": 1
    },
    "pairs": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "giver",
       "receiver",
       "code"
      ],
      "properties": {
       "giver": {
        "type": "string"
       },
       "receiver": {
        "type": "string"
       },
       "code": {
        "type": "string",
        "pattern": "^[0-9A-F]{4}$"
       }
      },
      "additionalProperties": false
     },
     "minItems": 3
    },
    "secret": {
     "const": true
    },
    "rule_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Invite": {
   "type": "object",
   "required": [
    "host_th",
    "title_th",
    "date_th",
    "time_th",
    "theme",
    "dress_th",
    "place_th",
    "address_th",
    "address_hidden",
    "rsvp_by",
    "palette",
    "watermark"
   ],
   "properties": {
    "host_th": {
     "type": "string"
    },
    "title_th": {
     "type": "string"
    },
    "date_th": {
     "type": "string"
    },
    "time_th": {
     "type": "string"
    },
    "theme": {
     "enum": [
      "countdown_gold",
      "cozy_xmas",
      "pastel_pop",
      "thai_fair",
      "neon_disco",
      "minimal_white"
     ]
    },
    "dress_th": {
     "type": "string"
    },
    "place_th": {
     "type": "string"
    },
    "address_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "address_hidden": {
     "type": "boolean"
    },
    "rsvp_by": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "palette": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "watermark": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "CostSplit": {
   "type": "object",
   "required": [
    "total",
    "host_pays",
    "payers",
    "kids_free",
    "each",
    "collected",
    "extra"
   ],
   "properties": {
    "total": {
     "type": "integer",
     "minimum": 0
    },
    "host_pays": {
     "type": "integer",
     "minimum": 0
    },
    "payers": {
     "type": "integer",
     "minimum": 1
    },
    "kids_free": {
     "type": "integer",
     "minimum": 0
    },
    "each": {
     "type": "integer",
     "minimum": 0
    },
    "collected": {
     "type": "integer",
     "minimum": 0
    },
    "extra": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "Countdown": {
   "type": "object",
   "required": [
    "date",
    "days_to_new_year",
    "be_year",
    "weekday_th"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "days_to_new_year": {
