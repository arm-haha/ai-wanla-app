{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-wanla-app.local/leafdoc/schemas.json",
  "title": "LeafDoc schemas",
  "$defs": {
    "DateLocal": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "HexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "SpeciesId": {
      "type": "string",
      "enum": [
        "monstera",
        "pothos",
        "snake",
        "zz",
        "rubber",
        "fiddle",
        "fern",
        "cactus",
        "spider"
      ]
    },
    "SymptomId": {
      "type": "string",
      "enum": [
        "yellow_lower",
        "yellow_all",
        "brown_tips",
        "crispy_edges",
        "black_stem",
        "drooping",
        "leaf_drop",
        "leggy",
        "spots_halo",
        "webbing",
        "sticky_bugs",
        "curling",
        "mushy_base",
        "no_growth",
        "sun_patches"
      ]
    },
    "CauseId": {
      "type": "string",
      "enum": [
        "overwater",
        "root_rot",
        "underwater",
        "low_light",
        "sunburn",
        "low_humidity",
        "spider_mites",
        "sap_bugs",
        "leaf_spot",
        "hungry"
      ]
    },
    "Light": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "bright_indirect",
        "direct"
      ]
    },
    "Pot": {
      "type": "string",
      "enum": [
        "plastic",
        "ceramic_glazed",
        "terracotta",
        "self_watering"
      ]
    },
    "Season": {
      "type": "string",
      "enum": [
        "hot",
        "rainy",
        "cool"
      ]
    },
    "Soil": {
      "type": "string",
      "enum": [
        "wet",
        "moist",
        "dry"
      ]
    },
    "Grade": {
      "type": "string",
      "enum": [
        "thriving",
        "fussy",
        "sick",
        "critical"
      ],
      "description": "thriving ≥80 · fussy 60–79 · sick 40–59 · critical <40"
    },
    "Species": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SpeciesId"
        },
        "name_th": {
          "type": "string"
        },
        "name_en": {
          "type": "string"
        },
        "base_water_days": {
          "type": "integer",
          "minimum": 1
        },
        "light_need": {
          "$ref": "#/$defs/Light"
        },
        "pet_toxic": {
          "type": "boolean"
        },
        "humidity_lover": {
          "type": "boolean"
        },
        "emoji": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name_th",
        "name_en",
        "base_water_days",
        "light_need",
        "pet_toxic",
        "humidity_lover",
        "emoji",
        "verified"
      ],
      "additionalProperties": false
    },
    "Symptom": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/SymptomId"
        },
        "label_th": {
          "type": "string"
        },
        "severity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        }
      },
      "required": [
        "id",
        "label_th",
        "severity"
      ],
      "additionalProperties": false
    },
    "Cause": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/CauseId"
        },
        "label_th": {
          "type": "string"
        },
        "emoji": {
          "type": "string"
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "explain_th": {
          "type": "string"
        },
        "plan_th": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 7,
          "maxItems": 7
        }
      },
      "required": [
        "id",
        "label_th",
        "emoji",
        "weights",
        "explain_th",
        "plan_th"
      ],
      "additionalProperties": false
    },
    "Plant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^p\\d+$"
        },
        "nickname_th": {
          "type": "string",
          "maxLength": 20
        },
        "species": {
          "$ref": "#/$defs/SpeciesId"
        },
        "light": {
          "$ref": "#/$defs/Light"
        },
        "pot": {
          "$ref": "#/$defs/Pot"
        },
        "last_watered": {
          "$ref": "#/$defs/DateLocal"
        },
        "added_on": {
          "$ref": "#/$defs/DateLocal"
        },
        "spot_th": {
          "type": "string"
        },
        "photo_key": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "nickname_th",
        "species",
        "light",
        "pot",
        "last_watered",
        "added_on"
      ],
      "additionalProperties": false
    },
    "CheckupContext": {
      "type": "object",
      "properties": {
        "soil": {
          "$ref": "#/$defs/Soil"
        },
        "light": {
          "$ref": "#/$defs/Light"
        },
        "days_since_water": {
          "type": "integer",
          "minimum": 0
        },
        "ac_room": {
          "type": "boolean"
        },
        "months_since_feed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "soil",
        "light",
        "days_since_water"
      ],
      "additionalProperties": false
    },
    "CheckupInput": {
      "type": "object",
      "properties": {
        "plant_id": {
          "type": "string"
        },
        "on": {
          "$ref": "#/$defs/DateLocal"
        },
        "symptoms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SymptomId"
          },
          "uniqueItems": true
        },
        "ctx": {
          "$ref": "#/$defs/CheckupContext"
        },
        "source": {
          "type": "string",
          "enum": [
            "chips",
            "ai_vision",
            "demo"
          ]
        }
      },
      "required": [
        "plant_id",
        "on",
        "symptoms",
        "ctx",
        "source"
      ],
      "additionalProperties": false
    },
    "CauseScore": {
      "type": "object",
      "properties": {
        "cause_id": {
          "$ref": "#/$defs/CauseId"
        },
        "label_th": {
          "type": "string"
        },
        "emoji": {
          "type": "string"
        },
        "points": {
          "type": "integer",
          "minimum": 1
        },
        "confidence_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SymptomId"
          },
          "minItems": 1
        },
        "explain_th": {
          "type": "string"
        }
      },
      "required": [
        "cause_id",
        "label_th",
        "emoji",
        "points",
        "confidence_pct",
        "evidence",
        "explain_th"
      ],
      "additionalProperties": false
    },
    "Diagnosis": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "plant_id": {
          "type": "string"
        },
        "species": {
          "$ref": "#/$defs/SpeciesId"
        },
        "on": {
          "$ref": "#/$defs/DateLocal"
        },
        "symptoms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SymptomId"
          }
        },
        "symptoms_th": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "health_score": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "grade": {
          "$ref": "#/$defs/Grade"
        },
        "grade_th": {
          "type": "string"
        },
        "emoji": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/HexColor"
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CauseScore"
          },
          "maxItems": 3
        },
        "top_cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/CauseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "disclaimer_th": {
          "type": "string"
        }
      },
      "required": [
        "engine",
        "plant_id",
        "species",
        "on",
        "symptoms",
        "symptoms_th",
        "health_score",
        "grade",
        "grade_th",
        "emoji",
        "color",
        "causes",
        "top_cause",
        "disclaimer_th"
      ],
      "additionalProperties": false
    },
    "WaterStatus": {
      "type": "object",
      "properties": {
        "interval_days": {
          "type": "integer",
          "minimum": 1
        },
        "days_since": {
          "type": "integer"
        },
        "due_on": {
          "$ref": "#/$defs/DateLocal"
        },
        "days_left": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": [
            "overdue",
            "today",
            "soon",
            "ok"
          ]
        },
        "status_th": {
          "type": "string"
        },
        "season": {
          "$ref": "#/$defs/Season"
        },
        "next_dates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DateLocal"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "finger_test_th": {
          "type": "string"
        }
      },
      "required": [
        "interval_days",
        "days_since",
        "due_on",
        "days_left",
        "status",
        "status_th",
        "season",
        "next_dates",
        "finger_test_th"
      ],
      "additionalProperties": false
    },
    "PlanDay": {
      "type": "object",
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "on": {
          "$ref": "#/$defs/DateLocal"
        },
        "task_th": {
          "type": "string"
        },
        "done": {
          "type": "boolean"
        },
        "extra_th": {
          "type": "string"
        }
      },
      "required": [
        "day",
        "on",
        "task_th",
        "done"
      ],
      "additionalProperties": false
    },
    "RescuePlan": {
      "type": "object",
      "properties": {
        "plant_id": {
          "type": "string"
        },
        "cause_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/CauseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "title_th": {
          "type": "string"
        },
        "start_on": {
          "$ref": "#/$defs/DateLocal"
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanDay"
          },
          "minItems": 7,
          "maxItems": 7
        },
        "recheck_on": {
          "$ref": "#/$defs/DateLocal"
        }
      },
      "required": [
        "plant_id",
        "cause_id",
        "title_th",
        "start_on",
        "days",
        "recheck_on"
      ],
      "additionalProperties": false
    },
    "PlanProgress": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer"
        },
        "of": {
          "type": "integer"
        },
        "pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "done",
        "of",
        "pct"
      ],
      "additionalProperties": false
    },
    "LightReading": {
      "type": "object",
      "properties": {
        "lux_est": {
          "type": "integer",
          "minimum": 0
        },
        "band": {
          "$ref": "#/$defs/Light"
        },
        "band_th": {
          "type": "string"
        },
        "fits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SpeciesId"
          }
        },
        "note_th": {
          "type": "string"
        }
      },
      "required": [
        "lux_est",
        "band",
        "band_th",
        "fits",
        "note_th"
      ],
      "additionalProperties": false
    },
    "PetCheck": {
      "type": "object",
      "properties": {
        "species": {
          "$ref": "#/$defs/SpeciesId"
        },
        "pet_toxic": {
          "type": "boolean"
        },
        "badge_th": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "source_note": {
          "type": "string"
        }
      },
      "required": [
        "species",
        "pet_toxic",
        "badge_th",
        "verified",
        "source_note"
      ],
      "additionalProperties": false
    },
    "RoomQuiz": {
      "type": "object",
      "properties": {
        "light": {
          "$ref": "#/$defs/Light"
        },
        "ac_room": {
          "type": "boolean"
        },
        "pets": {
          "type": "boolean"
        },
        "forgetful": {
          "type": "boolean"
        }
      },
      "required": [
        "light",
        "ac_room",
        "pets",
        "forgetful"
      ],
      "additionalProperties": false
    },
    "RoomMatch": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "species": {
            "$ref": "#/$defs/SpeciesId"
          },
          "name_th": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          },
          "fit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "species",
          "name_th",
          "emoji",
          "fit"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    },
    "GlowUpCard": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "glow_up"
        },
        "size": {
          "type": "string",
          "enum": [
            "1080x1920",
            "1080x1350"
          ]
        },
        "plant_id": {
          "type": "string"
        },
        "before_on": {
          "$ref": "#/$defs/DateLocal"
        },
        "after_on": {
          "$ref": "#/$defs/DateLocal"
        },
        "days": {
          "type": "integer"
        },
        "before_score": {
          "type": "integer"
        },
        "after_score": {
          "type": "integer"
        },
        "delta": {
          "type": "integer"
        },
        "new_leaves": {
          "type": "integer",
          "minimum": 0
        },
        "headline_th": {
          "type": "string"
        },
        "sub_th": {
          "type": "string"
        },
        "bg": {
          "$ref": "#/$defs/HexColor"
        },
        "accent": {
          "$ref": "#/$defs/HexColor"
        },
        "footer": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "size",
        "plant_id",
        "before_on",
        "after_on",
        "days",
        "before_score",
        "after_score",
        "delta",
        "new_leaves",
        "headline_th",
        "sub_th",
        "bg",
        "accent",
        "footer"
      ],
      "additionalProperties": false
    },
    "JungleLevel": {
      "type": "object",
      "properties": {
        "xp": {
          "type": "integer"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "title_th": {
          "type": "string"
        },
        "next_at": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "xp",
        "level",
        "title_th",
        "next_at"
      ],
      "additionalProperties": false
    },
    "LogEntry": {
      "type": "object",
      "properties": {
        "on": {
          "$ref": "#/$defs/DateLocal"
        },
        "kind": {
          "type": "string",
          "enum": [
            "water",
            "checkup",
            "feed",
            "repot",
            "photo"
          ]
        },
        "plant_id": {
          "type": "string"
        },
        "on_time": {
          "type": "boolean"
        },
        "top_cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/CauseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "delta": {
          "type": "integer"
        },
        "score": {
          "type": "integer"
        }
      },
      "required": [
        "on",
        "kind",
        "plant_id"
      ],
      "additionalProperties": false
    },
    "Wrapped": {
      "type": "object",
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "waterings": {
          "type": "integer"
        },
        "on_time_pct": {
          "type": "integer"
        },
        "checkups": {
          "type": "integer"
        },
        "top_cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/CauseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_cause_th": {
          "type": [
            "string",
            "null"
          ]
        },
        "best_glow_plant": {
          "type": [
            "string",
            "null"
          ]
        },
        "best_delta": {
          "type": "integer"
        }
      },
      "required": [
        "month",
        "waterings",
        "on_time_pct",
        "checkups",
        "top_cause",
        "top_cause_th",
        "best_glow_plant",
        "best_delta"
      ],
      "additionalProperties": false
    },
    "Settings": {
      "type": "object",
      "properties": {
        "reminder_time": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "has_pets": {
          "type": "boolean"
        },
        "ac_room": {
          "type": "boolean"
        },
        "ai_vision": {
          "type": "boolean"
        }
      },
      "required": [
        "reminder_time",
        "has_pets",
        "ac_room",
        "ai_vision"
      ],
      "additionalProperties": false
    },
    "LocalStore": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "plants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Plant"
          },
          "maxItems": 100
        },
        "diagnoses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnosis"
          }
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RescuePlan"
          }
        },
        "log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LogEntry"
          },
          "maxItems": 2000
        },
        "care_days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DateLocal"
          }
        }
      },
      "required": [
        "version",
        "settings",
        "plants",
        "log"
      ],
      "additionalProperties": false
    },
    "AiVisionRequest": {
      "type": "object",
      "properties": {
        "image_b64_jpeg": {
          "type": "string",
          "description": "≤ 1024px long side"
        },
        "known_species": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "image_b64_jpeg",
        "known_species"
      ],
      "additionalProperties": false
    },
    "AiVisionResponse": {
      "type": "object",
      "properties": {
        "species_guess": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeciesId"
            },
            {
              "const": "unknown"
            }
          ]
        },
        "species_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "symptoms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SymptomId"
          },
          "uniqueItems": true,
          "maxItems": 6
        },
        "leaf_boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              },
              "symptom": {
                "$ref": "#/$defs/SymptomId"
              }
            },
            "required": [
              "x",
              "y",
              "w",
              "h",
              "symptom"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        },
        "note_th": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "species_guess",
        "species_confidence",
        "symptoms"
      ],
      "additionalProperties": false
    },
    "AiCareChatResponse": {
      "type": "object",
      "properties": {
        "answer_th": {
          "type": "string",
          "maxLength": 400
        },
        "never_change_score": {
          "const": true
        }
      },
      "required": [
        "answer_th",
        "never_change_score"
      ],
      "additionalProperties": false
    }
  }
}