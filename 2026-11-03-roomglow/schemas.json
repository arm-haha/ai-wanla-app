{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "roomglow.schemas.json",
 "title": "RoomGlow schemas",
 "$defs": {
  "Room": {
   "type": "object",
   "required": [
    "name",
    "room_type",
    "width_m",
    "length_m",
    "height_m",
    "renter",
    "budget_thb"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "room_type": {
     "enum": [
      "bedroom",
      "living",
      "studio",
      "desk",
      "kitchen"
     ]
    },
    "width_m": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "length_m": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "height_m": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "doors": {
     "type": "integer",
     "minimum": 0
    },
    "windows": {
     "type": "integer",
     "minimum": 0
    },
    "renter": {
     "type": "boolean"
    },
    "budget_thb": {
     "type": "number",
     "minimum": 0
    },
    "existing_lm": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "RoomScanExtract": {
   "type": "object",
   "required": [
    "room_found",
    "room_type",
    "scores",
    "items_seen",
    "wall_color_hex",
    "confidence",
    "retake_reason_th"
   ],
   "properties": {
    "room_found": {
     "type": "boolean"
    },
    "room_type": {
     "enum": [
      "bedroom",
      "living",
      "studio",
      "desk",
      "kitchen",
      null
     ]
    },
    "scores": {
     "type": "object",
     "required": [
      "light",
      "clutter",
      "harmony",
      "cohesion"
     ],
     "properties": {
      "light": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "clutter": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "harmony": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "cohesion": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      }
     }
    },
    "items_seen": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "label_th",
       "kind"
      ],
      "properties": {
       "label_th": {
        "type": "string"
       },
       "kind": {
        "enum": [
         "furniture",
         "textile",
         "light",
         "clutter",
         "decor",
         "window",
         "door"
        ]
       },
       "bbox": {
        "type": "array",
        "items": {
         "type": "number"
        }
       }
      }
     }
    },
    "wall_color_hex": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "est_size_m": {
     "type": "object",
     "required": [],
     "properties": {
      "width": {
       "type": [
        "number",
        "null"
       ]
      },
      "length": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "retake_reason_th": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "GlowScore": {
   "type": "object",
   "required": [
    "before",
    "after",
    "delta"
   ],
   "properties": {
    "before": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "after": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "delta": {
     "type": "integer"
    }
   }
  },
  "CatalogItem": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "category",
    "price_thb",
    "impact",
    "renter_safe",
    "styles",
    "minutes"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "name_th": {
     "type": "string"
    },
    "category": {
     "enum": [
      "declutter",
      "wall",
      "furniture",
      "textile",
      "light",
      "decor",
      "plant"
     ]
    },
    "price_thb": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "impact": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10
    },
    "renter_safe": {
     "type": "boolean"
    },
    "styles": {
     "type": "array",
     "items": {
      "enum": [
       "muji",
       "korean",
       "japandi",
       "cozy",
       "boho",
       "industrial",
       "any"
      ]
     }
    },
    "minutes": {
     "type": "number",
     "minimum": 0
    },
    "boost": {
     "type": "object",
     "additionalProperties": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     }
    },
    "shop_query_th": {
     "type": "string"
    }
   }
  },
  "RestyleRequest": {
   "type": "object",
   "required": [
    "style",
    "source_photo",
    "prompt"
   ],
   "properties": {
    "style": {
     "enum": [
      "muji",
      "korean",
      "japandi",
      "cozy",
      "boho",
      "industrial"
     ]
    },
    "source_photo": {
     "type": "string"
    },
    "prompt": {
     "type": "string"
    },
    "keep_layout": {
     "type": "boolean"
    },
    "item_ids": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "seed": {
     "type": "integer"
    }
   }
  },
  "RestyleResult": {
   "type": "object",
   "required": [
    "style",
    "image_url",
    "layout_ok",
    "status"
   ],
   "properties": {
    "style": {
     "enum": [
      "muji",
      "korean",
      "japandi",
      "cozy",
      "boho",
      "industrial"
     ]
    },
    "image_url": {
     "type": [
      "string",
      "null"
     ]
    },
    "layout_ok": {
     "type": "boolean"
    },
    "status": {
     "enum": [
      "ok",
      "retry",
      "blocked"
     ]
    },
    "note_th": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "ShoppingPlan": {
   "type": "object",
   "required": [
    "style",
    "budget_thb",
    "spent_thb",
    "left_thb",
    "impact",
    "items",
    "budget_used_pct"
   ],
   "properties": {
    "style": {
     "enum": [
      "muji",
      "korean",
      "japandi",
      "cozy",
      "boho",
      "industrial"
     ]
    },
    "budget_thb": {
     "type": "number",
     "minimum": 0
    },
    "spent_thb": {
     "type": "number",
     "minimum": 0
    },
    "left_thb": {
     "type": "number",
     "minimum": 0
    },
    "impact": {
     "type": "integer",
     "minimum": 0
    },
    "items": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "excluded_not_renter_safe": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "budget_used_pct": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    }
   }
  },
  "PaintEstimate": {
   "type": "object",
   "required": [
    "liters",
    "cans",
    "cost_thb"
   ],
   "properties": {
    "liters": {
     "type": "number",
     "minimum": 0
    },
    "cans": {
     "type": "integer",
     "minimum": 0
    },
    "cost_thb": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "WallpaperEstimate": {
   "type": "object",
   "required": [
    "rolls",
    "cost_thb"
   ],
   "properties": {
    "rolls": {
     "type": "integer",
     "minimum": 0
    },
    "cost_thb": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "LightPlan": {
   "type": "object",
   "required": [
    "lumens_needed",
    "existing_lm",
    "gap_lm",
    "bulbs_800lm",
    "kelvin",
    "tip_th"
   ],
   "properties": {
    "lumens_needed": {
     "type": "integer",
     "minimum": 0
    },
    "existing_lm": {
     "type": "number",
     "minimum": 0
    },
    "gap_lm": {
     "type": "number",
     "minimum": 0
    },
    "bulbs_800lm": {
     "type": "integer",
     "minimum": 0
    },
    "kelvin": {
     "enum": [
      2700,
      3000,
      4000
     ]
    },
    "tip_th": {
     "type": "string"
    }
   }
  },
  "Palette": {
   "type": "object",
   "required": [
    "style",
    "colors"
   ],
   "properties": {
    "style": {
     "enum": [
      "muji",
      "korean",
      "japandi",
      "cozy",
      "boho",
      "industrial"
     ]
    },
    "colors": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "hex",
       "role"
      ],
      "properties": {
       "hex": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
       },
       "role": {
        "enum": [
         "base",
         "secondary",
         "accent",
         "wood",
         "metal"
        ]
       },
       "name_th": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "DeclutterItem": {
   "type": "object",
   "required": [
    "name",
    "action"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "action": {
     "enum": [
      "keep",
      "sell",
      "donate",
      "toss"
     ]
    },
    "resale_thb": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "DeclutterResult": {
   "type": "object",
   "required": [
    "counts",
    "resale_thb",
    "removed"
   ],
   "properties": {
    "counts": {
     "type": "object",
     "required": [
      "keep",
      "sell",
      "donate",
      "toss"
     ],
     "properties": {
      "keep": {
       "type": "integer",
       "minimum": 0
      },
      "sell": {
       "type": "integer",
       "minimum": 0
      },
      "donate": {
       "type": "integer",
       "minimum": 0
      },
      "toss": {
       "type": "integer",
       "minimum": 0
      }
     }
    },
    "resale_thb": {
     "type": "number",
     "minimum": 0
    },
    "removed": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "WeekendPlan": {
   "type": "object",
   "required": [
    "steps",
    "total_minutes",
    "total_hours"
   ],
   "properties": {
    "steps": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "item",
       "name_th",
       "minutes",
       "cum_minutes"
      ],
      "properties": {
       "item": {
        "type": "string"
       },
       "name_th": {
        "type": "string"
       },
       "minutes": {
        "type": "number",
        "minimum": 0
       },
       "cum_minutes": {
        "type": "number",
        "minimum": 0
       }
      }
     }
    },
    "total_minutes": {
     "type": "number",
     "minimum": 0
    },
    "total_hours": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "Vote": {
   "type": "object",
   "required": [
    "voter",
    "option"
   ],
   "properties": {
    "voter": {
     "type": "string",
     "minLength": 1
    },
    "option": {
     "type": "string"
    }
   }
  },
  "PollResult": {
   "type": "object",
   "required": [
    "total_votes",
    "rows",
    "winner",
    "tie"
   ],
   "properties": {
    "total_votes": {
     "type": "integer",
     "minimum": 0
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "option",
       "votes",
       "pct"
      ],
      "properties": {
       "option": {
        "type": "string"
       },
       "votes": {
        "type": "integer",
        "minimum": 0
       },
       "pct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
       }
      }
     }
    },
    "winner": {
     "type": [
      "string",
      "null"
     ]
    },
    "tie": {
     "type": "boolean"
    }
   }
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "kind",
    "title_th",
    "big_stat",
    "sub_th"
   ],
   "properties": {
    "kind": {
     "enum": [
      "style_grid",
      "before_after",
      "budget_receipt",
      "poll",
      "glow_score"
     ]
    },
    "title_th": {
     "type": "string"
    },
    "big_stat": {
     "type": "string"
    },
    "sub_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   }
  }
 }
}