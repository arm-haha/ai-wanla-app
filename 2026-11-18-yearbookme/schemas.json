{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/yearbookme.schema.json",
 "title": "YearbookMe",
 "$defs": {
  "Person": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "age",
    "own_photo",
    "consent_confirmed"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "nickname_th": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 1
    },
    "city_th": {
     "type": "string"
    },
    "goal_th": {
     "type": "string"
    },
    "own_photo": {
     "type": "boolean"
    },
    "consent_confirmed": {
     "type": "boolean"
    },
    "guardian_ok": {
     "type": "boolean"
    },
    "all_consented": {
     "type": "boolean"
    },
    "celebrity_likely": {
     "type": "boolean"
    },
    "consented": {
     "type": "boolean"
    },
    "role": {
     "enum": [
      "class_president",
      "yearbook_club",
      "most_likely_friend",
      "most_likely_travel",
      "quiet_star",
      "mc"
     ]
    }
   },
   "additionalProperties": false
  },
  "Detection": {
   "type": "object",
   "required": [
    "label",
    "confidence"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "own_face": {
     "type": "boolean"
    },
    "celebrity_likely": {
     "type": "boolean"
    },
    "age_apparent": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "SelfiePhoto": {
   "type": "object",
   "required": [
    "id",
    "px_w",
    "px_h",
    "glare",
    "blur",
    "crop",
    "detections"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^p[0-9]{2}$"
    },
    "px_w": {
     "type": "integer",
     "minimum": 1
    },
    "px_h": {
     "type": "integer",
     "minimum": 1
    },
    "glare": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "blur": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "crop": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "detections": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Detection"
     }
    }
   },
   "additionalProperties": false
  },
  "ScanQuality": {
   "type": "object",
   "required": [
    "score",
    "ok",
    "tips_th",
    "face_count"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "ok": {
     "type": "boolean"
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "face_count": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "IdentifiedFace": {
   "type": "object",
   "required": [
    "label",
    "confidence",
    "own_face",
    "celebrity_likely"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "own_face": {
     "type": "boolean"
    },
    "celebrity_likely": {
     "type": "boolean"
    },
    "age_apparent": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "PhotoScan": {
   "type": "object",
   "required": [
    "photo_id",
    "quality",
    "faces",
    "uncertain",
    "face_count"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "quality": {
     "$ref": "#/$defs/ScanQuality"
    },
    "faces": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/IdentifiedFace"
     }
    },
    "uncertain": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "face_count": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "Pipeline": {
   "type": "object",
   "required": [
    "photo_id",
    "steps"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "steps": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    }
   },
   "additionalProperties": false
  },
  "ConsentGuard": {
   "type": "object",
   "required": [
    "ok",
    "level",
    "reasons_th",
    "blocks_th",
    "message_th",
    "face_count",
    "disclaimer_th"
   ],
   "properties": {
    "ok": {
     "type": "boolean"
    },
    "level": {
     "enum": [
      "ok",
      "block"
     ]
    },
    "reasons_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "blocks_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "message_th": {
     "type": "string"
    },
    "face_count": {
     "type": "integer",
     "minimum": 0
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "EraInfo": {
   "type": "object",
   "required": [
    "id",
    "era",
    "name_th",
    "name_en",
    "year_label",
    "grade_th",
    "palette",
    "typography",
    "props_th",
    "hair_th",
    "clothes_th"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^e[0-9a-z]{2}$"
    },
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "year_label": {
     "type": "string"
    },
    "grade_th": {
     "type": "string"
    },
    "palette": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "typography": {
     "type": "string"
    },
    "props_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hair_th": {
     "type": "string"
    },
    "clothes_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "StyleRender": {
   "type": "object",
   "required": [
    "photo_id",
    "era",
    "name_th",
    "name_en",
    "year_label",
    "score",
    "badge_th",
    "grade_th",
    "palette",
    "typography",
    "grain",
    "flash",
    "frame",
    "props_th",
    "hair_th",
    "clothes_th",
    "headline_th",
    "hook_th"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "year_label": {
     "type": "string"
    },
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "badge_th": {
     "type": "string"
    },
    "grade_th": {
     "type": "string"
    },
    "palette": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "typography": {
     "type": "string"
    },
    "grain": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "flash": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "frame": {
     "type": "string"
    },
    "props_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "hair_th": {
     "type": "string"
    },
    "clothes_th": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "hook_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "EraStudio": {
   "type": "object",
   "required": [
    "photo_id",
    "name_th",
    "top_era",
    "top_score",
    "renders",
    "count"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "top_era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "top_score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "renders": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/StyleRender"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "count": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "PropKit": {
   "type": "object",
   "required": [
    "era",
    "name_th",
    "props_th",
    "frame",
    "tip_th"
   ],
   "properties": {
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "props_th": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "frame": {
     "type": "string"
    },
    "tip_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "CaptionQuote": {
   "type": "object",
   "required": [
    "n",
    "era",
    "tone",
    "text_th",
    "for_name_th"
   ],
   "properties": {
    "n": {
     "type": "integer",
     "minimum": 1
    },
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "tone": {
     "enum": [
      "sweet",
      "funny",
      "proud",
      "nostalgic"
     ]
    },
    "text_th": {
     "type": "string"
    },
    "for_name_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Autograph": {
   "type": "object",
   "required": [
    "from_name_th",
    "to_name_th",
    "era",
    "tone",
    "text_th",
    "char_count"
   ],
   "properties": {
    "from_name_th": {
     "type": "string"
    },
    "to_name_th": {
     "type": "string"
    },
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "tone": {
     "enum": [
      "sweet",
      "funny",
      "proud",
      "nostalgic"
     ]
    },
    "text_th": {
     "type": "string"
    },
    "char_count": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "MemberSlot": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "name_en",
    "nickname_th",
    "role",
    "role_th",
    "era",
    "score",
    "headline_th",
    "consented"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "nickname_th": {
     "type": "string"
    },
    "role": {
     "enum": [
      "class_president",
      "yearbook_club",
      "most_likely_friend",
      "most_likely_travel",
      "quiet_star",
      "mc"
     ]
    },
    "role_th": {
     "type": "string"
    },
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "headline_th": {
     "type": "string"
    },
    "consented": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "YearbookPage": {
   "type": "object",
   "required": [
    "title_th",
    "school_th",
    "year",
    "era",
    "year_label",
    "frame",
    "palette",
    "members",
    "member_count",
    "cols",
    "rows",
    "disclaimer_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "school_th": {
     "type": "string"
    },
    "year": {
     "type": "integer",
     "minimum": 1900,
     "maximum": 2100
    },
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "year_label": {
     "type": "string"
    },
    "frame": {
     "type": "string"
    },
    "palette": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "members": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/MemberSlot"
     },
     "minItems": 1
    },
    "member_count": {
     "type": "integer",
     "minimum": 1
    },
    "cols": {
     "type": "integer",
     "minimum": 1
    },
    "rows": {
     "type": "integer",
     "minimum": 1
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "PrintSheet": {
   "type": "object",
   "required": [
    "name_th",
    "era",
    "year_label",
    "quote_th",
    "layout",
    "label_th",
    "sizes",
    "bleed_mm",
    "watermark",
    "cta_th"
   ],
   "properties": {
    "name_th": {
     "type": "string"
    },
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "year_label": {
     "type": "string"
    },
    "quote_th": {
     "type": "string"
    },
    "layout": {
     "enum": [
      "portrait_a4",
      "four_up",
      "sticker"
     ]
    },
    "label_th": {
     "type": "string"
    },
    "sizes": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "bleed_mm": {
     "type": "integer",
     "minimum": 0
    },
    "watermark": {
     "type": "string"
    },
    "cta_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "title_th",
    "headline_th",
    "hook_th",
    "era",
    "score",
    "quote_th",
    "layout",
    "sizes",
    "watermark",
    "cta_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "hook_th": {
     "type": "string"
    },
    "era": {
     "enum": [
      "80s",
      "90s",
      "y2k"
     ]
    },
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "quote_th": {
     "type": "string"
    },
    "layout": {
     "enum": [
      "era_portrait"
     ]
    },
    "sizes": {
     "type": "array",
     "items": {
      "enum": [
       "1080x1350",
       "1080x1920",
       "1080x1080"
      ]
     }
    },
    "watermark": {
     "type": "string"
    },
    "cta_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "allowed",
    "left_after",
    "paywall"
   ],
   "properties": {
    "allowed": {
     "type": "integer",
     "minimum": 0
    },
    "left_after": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "paywall": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "SafetyGuard": {
   "type": "object",
   "required": [
    "level",
    "message_th"
   ],
   "properties": {
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 }
}