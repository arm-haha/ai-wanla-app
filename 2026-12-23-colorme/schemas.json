{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/arm-haha/ai-wanla-app/2026-12-23-colorme/schemas.json",
 "title": "ColorMe",
 "$defs": {
  "Child": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "name_en",
    "age",
    "city_th"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 3,
     "maximum": 120
    },
    "city_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Crayon": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "name_en",
    "hex"
   ],
   "properties": {
    "key": {
     "enum": [
      "red",
      "orange",
      "yellow",
      "lime",
      "green",
      "sky",
      "blue",
      "purple",
      "pink",
      "brown",
      "gray",
      "black",
      "white"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "hex": {
     "type": "string",
     "pattern": "^#[0-9A-F]{6}$"
    }
   },
   "additionalProperties": false
  },
  "Level": {
   "type": "object",
   "required": [
    "key",
    "name_th",
    "ages",
    "max_colors",
    "min_area",
    "max_regions",
    "line_px",
    "numbers",
    "dots"
   ],
   "properties": {
    "key": {
     "enum": [
      "tiny",
      "kid",
      "big",
      "calm"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "ages": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "max_colors": {
     "type": "integer",
     "minimum": 1
    },
    "min_area": {
     "type": "integer",
     "minimum": 1
    },
    "max_regions": {
     "type": "integer",
     "minimum": 1
    },
    "line_px": {
     "type": "integer",
     "minimum": 1
    },
    "numbers": {
     "type": "boolean"
    },
    "dots": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "PhotoInput": {
   "type": "object",
   "required": [
    "id",
    "light",
    "sharp",
    "subject",
    "busy",
    "w",
    "h"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "light": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "sharp": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "subject": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "busy": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "w": {
     "type": "integer",
     "minimum": 1
    },
    "h": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "PhotoCheck": {
   "type": "object",
   "required": [
    "score",
    "ok",
    "tips_th"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "ok": {
     "type": "boolean"
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "AiPhotoClean": {
   "type": "object",
   "required": [
    "subject_th",
    "background",
    "people",
    "child_faces",
    "nudity",
    "id_document",
    "violent",
    "copyright_character",
    "suggested_title_th",
    "confidence"
   ],
   "properties": {
    "subject_th": {
     "type": "string"
    },
    "background": {
     "enum": [
      "keep",
      "simplify",
      "remove"
     ]
    },
    "people": {
     "type": "integer",
     "minimum": 0
    },
    "child_faces": {
     "type": "integer",
     "minimum": 0
    },
    "nudity": {
     "type": "boolean"
    },
    "id_document": {
     "type": "boolean"
    },
    "violent": {
     "type": "boolean"
    },
    "copyright_character": {
     "type": "boolean"
    },
    "suggested_title_th": {
     "type": "string"
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "Palette": {
   "type": "object",
   "required": [
    "level",
    "keys"
   ],
   "properties": {
    "level": {
     "enum": [
      "tiny",
      "kid",
      "big",
      "calm"
     ]
    },
    "keys": {
     "type": "array",
     "items": {
      "enum": [
       "red",
       "orange",
       "yellow",
       "lime",
       "green",
       "sky",
       "blue",
       "purple",
       "pink",
       "brown",
       "gray",
       "black",
       "white"
      ]
     },
     "minItems": 1,
     "maxItems": 13
    }
   },
   "additionalProperties": false
  },
  "LegendItem": {
   "type": "object",
   "required": [
    "num",
    "key",
    "name_th",
    "hex",
    "regions"
   ],
   "properties": {
    "num": {
     "type": "integer",
     "minimum": 1
    },
    "key": {
     "enum": [
      "red",
      "orange",
      "yellow",
      "lime",
      "green",
      "sky",
      "blue",
      "purple",
      "pink",
      "brown",
      "gray",
      "black",
      "white"
     ]
    },
    "name_th": {
     "type": "string"
    },
    "hex": {
     "type": "string",
     "pattern": "^#[0-9A-F]{6}$"
    },
    "regions": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "RegionLabel": {
   "type": "object",
   "required": [
    "region",
    "num",
    "x",
    "y",
    "fits"
   ],
   "properties": {
    "region": {
     "type": "integer",
     "minimum": 1
    },
    "num": {
     "type": "integer",
     "minimum": 1
    },
    "x": {
     "type": "integer",
     "minimum": 0
    },
    "y": {
     "type": "integer",
     "minimum": 0
    },
    "fits": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "ColoringPage": {
   "type": "object",
   "required": [
    "level",
    "mode",
    "w",
    "h",
    "colors",
    "regions",
    "min_area",
    "simplify_passes",
    "line_px",
    "show_numbers",
    "edge_ratio",
    "legend",
    "labels"
   ],
   "properties": {
    "level": {
     "enum": [
      "tiny",
      "kid",
      "big",
      "calm"
     ]
    },
    "mode": {
     "enum": [
      "lineart",
      "numbers"
     ]
    },
    "w": {
     "type": "integer",
     "minimum": 1
    },
    "h": {
     "type": "integer",
     "minimum": 1
    },
    "colors": {
     "type": "integer",
     "minimum": 1
    },
    "regions": {
     "type": "integer",
     "minimum": 1
    },
    "min_area": {
     "type": "integer",
     "minimum": 1
    },
    "simplify_passes": {
     "type": "integer",
     "minimum": 0
    },
    "line_px": {
     "type": "integer",
     "minimum": 1
    },
    "show_numbers": {
     "type": "boolean"
    },
    "edge_ratio": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "legend": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/LegendItem"
     },
     "minItems": 1
    },
    "labels": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/RegionLabel"
     }
    }
   },
   "additionalProperties": false
  },
  "Dot": {
   "type": "object",
   "required": [
    "num",
    "x",
    "y"
   ],
   "properties": {
    "num": {
     "type": "integer",
     "minimum": 1
    },
    "x": {
     "type": "number"
    },
    "y": {
     "type": "number"
    }
   },
   "additionalProperties": false
  },
  "DotPage": {
   "type": "object",
   "required": [
    "level",
    "dots",
    "perimeter",
    "spacing",
    "closed"
   ],
   "properties": {
    "level": {
     "enum": [
      "tiny",
      "kid",
      "big",
      "calm"
     ]
    },
    "dots": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Dot"
     },
     "minItems": 3
    },
    "perimeter": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "spacing": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "closed": {
     "const": true
    }
   },
   "additionalProperties": false
  },
  "Booklet": {
   "type": "object",
   "required": [
    "title_th",
    "pages",
    "sheets_double_sided",
    "paper",
    "dpi",
    "px",
    "ink_saver",
    "line_px",
    "ink_pct",
    "has_answer_key"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "pages": {
     "type": "integer",
     "minimum": 2,
     "maximum": 13
    },
    "sheets_double_sided": {
     "type": "integer",
     "minimum": 1
    },
    "paper": {
     "const": "A4"
    },
    "dpi": {
     "const": 300
    },
    "px": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 1
     },
     "minItems": 2,
     "maxItems": 2
    },
    "ink_saver": {
     "type": "boolean"
    },
    "line_px": {
     "type": "integer",
     "minimum": 1
    },
    "ink_pct": {
     "type": "number",
     "minimum": 0,
     "maximum": 35
    },
    "has_answer_key": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "Progress": {
   "type": "object",
   "required": [
    "coverage_pct",
    "in_lines_pct",
    "match_pct",
    "stars",
    "favorite",
    "praise_th",
    "done"
   ],
   "properties": {
    "coverage_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "in_lines_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "match_pct": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "stars": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    },
    "favorite": {
     "enum": [
      "red",
      "orange",
      "yellow",
      "lime",
      "green",
      "sky",
      "blue",
      "purple",
      "pink",
      "brown",
      "gray",
      "black",
      "white",
      null
     ]
    },
    "praise_th": {
     "type": "string"
    },
    "done": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "Quest": {
   "type": "object",
   "required": [
    "date",
    "theme_th",
    "streak",
    "done_today",
    "new_sticker"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "theme_th": {
     "enum": [
      "น้องหมาน้องแมวที่บ้าน",
      "อาหารจานโปรด",
      "ของเล่นชิ้นโปรด",
      "วิวหน้าบ้าน",
      "ผลไม้ในตู้เย็น",
      "รองเท้าของเรา",
      "ต้นไม้ใกล้บ้าน",
      "ท้องฟ้าวันนี้",
      "ขนมไทย",
      "รถคันโปรด",
      "ห้องนอนของเรา",
      "ที่เที่ยวปิดเทอม",
      "ตุ๊กตาตัวโปรด",
      "ของขวัญปีใหม่"
     ]
    },
    "streak": {
     "type": "integer",
     "minimum": 0
    },
    "done_today": {
     "type": "boolean"
    },
    "new_sticker": {
     "enum": [
      "ดินสอสีทอง",
      "จานสีสายรุ้ง",
      "มงกุฎศิลปิน",
      "ถ้วยจิตรกรน้อย",
      null
     ]
    }
   },
   "additionalProperties": false
  },
  "GalleryEntry": {
   "type": "object",
   "required": [
    "date",
    "title_th",
    "stars",
    "favorite"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "title_th": {
     "type": "string"
    },
    "stars": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    },
    "favorite": {
     "enum": [
      "red",
      "orange",
      "yellow",
      "lime",
      "green",
      "sky",
      "blue",
      "purple",
      "pink",
      "brown",
      "gray",
      "black",
      "white",
      null
     ]
    }
   },
   "additionalProperties": false
  },
  "GallerySummary": {
   "type": "object",
   "required": [
    "month",
    "pages",
    "stars",
    "favorite_th",
    "art_book_ready",
    "note_th"
   ],
   "properties": {
    "month": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "pages": {
     "type": "integer",
     "minimum": 0
    },
    "stars": {
     "type": "integer",
     "minimum": 0
    },
    "favorite_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "art_book_ready": {
     "type": "boolean"
    },
    "note_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "layout",
    "size",
    "child_face_hidden",
    "stars",
    "level_th",
    "watermark",
    "badge_th"
   ],
   "properties": {
    "layout": {
     "enum": [
      "before_after",
      "reveal",
      "booklet"
     ]
    },
    "size": {
     "const": "1080x1350"
    },
    "child_face_hidden": {
     "const": true
    },
    "stars": {
     "type": [
      "integer",
      "null"
     ]
    },
    "level_th": {
     "type": "string"
    },
    "watermark": {
     "type": "string"
    },
    "badge_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ReelShot": {
   "type": "object",
   "required": [
    "kind",
    "start",
    "end",
    "caption_th"
   ],
   "properties": {
    "kind": {
     "enum": [
      "hook",
      "build",
      "magic",
      "numbers",
      "reveal",
      "cta"
     ]
    },
    "start": {
     "type": "number",
     "minimum": 0
    },
    "end": {
     "type": "number"
    },
    "caption_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ReelPlan": {
   "type": "object",
   "required": [
    "seconds",
    "ratio",
    "bpm",
    "shots",
    "watermark"
   ],
   "properties": {
    "seconds": {
     "type": "integer",
     "minimum": 15,
     "maximum": 30
    },
    "ratio": {
     "const": "9:16"
    },
    "bpm": {
     "type": "integer",
     "minimum": 1
    },
    "shots": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ReelShot"
     },
     "minItems": 3
    },
    "watermark": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "plan",
    "pages_per_day",
    "used",
    "left",
    "blocked"
   ],
   "properties": {
    "plan": {
     "enum": [
      "free",
      "plus"
     ]
    },
    "pages_per_day": {
     "type": "integer",
     "minimum": 1
    },
    "used": {
     "type": "integer",
     "minimum": 0
    },
    "left": {
     "type": "integer",
     "minimum": 0
    },
    "blocked": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "PrivacyCheck": {
   "type": "object",
   "required": [
    "allowed",
    "level",
    "flags",
    "messages_th",
    "parent_mode",
    "share_allowed"
   ],
   "properties": {
    "allowed": {
     "type": "boolean"
    },
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "flags": {
     "type": "array",
     "items": {
      "enum": [
       "nudity",
       "id_document",
       "violent",
       "other_child_face",
       "copyright_character",
       "selling_pages",
       "screen_time",
       "under_3"
      ]
     }
    },
    "messages_th": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "parent_mode": {
     "type": "boolean"
    },
    "share_allowed": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "SafetyGuard": {
   "type": "object",
   "required": [
    "flag",
    "level",
    "message_th",
    "block"
   ],
   "properties": {
    "flag": {
     "type": [
      "string",
      "null"
     ]
    },
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "message_th": {
     "type": "string"
    },
    "block": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  }
 }
}