{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "labellens.schemas.json",
 "title": "LabelLens schemas",
 "$defs": {
  "UserProfile": {
   "type": "object",
   "required": [
    "name",
    "allergies",
    "goal"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "allergies": {
     "type": "array",
     "items": {
      "enum": [
       "egg",
       "fish",
       "milk",
       "peanut",
       "sesame",
       "shrimp",
       "soy",
       "wheat"
      ]
     }
    },
    "goal": {
     "enum": [
      "cut_sugar",
      "cut_salt",
      "balanced",
      "kid_mode"
     ]
    },
    "daily_limits": {
     "type": "object",
     "properties": {
      "sugar_g": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "sodium_mg": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "fat_g": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "kcal": {
       "type": "number",
       "exclusiveMinimum": 0
      }
     }
    }
   }
  },
  "Nutrients": {
   "type": "object",
   "required": [
    "kcal",
    "sugar_g",
    "fat_g",
    "sodium_mg"
   ],
   "properties": {
    "kcal": {
     "type": "number",
     "minimum": 0
    },
    "sugar_g": {
     "type": "number",
     "minimum": 0
    },
    "fat_g": {
     "type": "number",
     "minimum": 0
    },
    "sodium_mg": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "Label": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "category",
    "form",
    "serving_size",
    "servings_per_pack",
    "per_serving",
    "ingredients_th"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string",
     "minLength": 1
    },
    "category": {
     "type": "string"
    },
    "form": {
     "enum": [
      "drink",
      "solid"
     ]
    },
    "serving_size": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "servings_per_pack": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "per_serving": {
     "$ref": "#/$defs/Nutrients"
    },
    "price_thb": {
     "type": "number",
     "minimum": 0
    },
    "ingredients_th": {
     "type": "string"
    },
    "additives": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^E[0-9]{3,4}[a-z]?$"
     }
    },
    "barcode": {
     "type": "string"
    },
    "ocr_confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  },
  "PackTotals": {
   "type": "object",
   "required": [
    "kcal",
    "sugar_g",
    "fat_g",
    "sodium_mg"
   ],
   "properties": {
    "kcal": {
     "type": "number",
     "minimum": 0
    },
    "sugar_g": {
     "type": "number",
     "minimum": 0
    },
    "fat_g": {
     "type": "number",
     "minimum": 0
    },
    "sodium_mg": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "SugarSpoons": {
   "type": "object",
   "required": [
    "sugar_g",
    "tsp"
   ],
   "properties": {
    "sugar_g": {
     "type": "number"
    },
    "tsp": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "Grade": {
   "type": "object",
   "required": [
    "score",
    "grade",
    "lights"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "grade": {
     "enum": [
      "A",
      "B",
      "C",
      "D",
      "E"
     ]
    },
    "lights": {
     "type": "object",
     "required": [
      "sugar_g",
      "fat_g",
      "sodium_mg"
     ],
     "properties": {
      "sugar_g": {
       "enum": [
        "green",
        "amber",
        "red"
       ]
      },
      "fat_g": {
       "enum": [
        "green",
        "amber",
        "red"
       ]
      },
      "sodium_mg": {
       "enum": [
        "green",
        "amber",
        "red"
       ]
      }
     }
    }
   }
  },
  "AllergenCheck": {
   "type": "object",
   "required": [
    "safe",
    "hits"
   ],
   "properties": {
    "safe": {
     "type": "boolean"
    },
    "hits": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "allergen",
       "matched"
      ],
      "properties": {
       "allergen": {
        "type": "string"
       },
       "matched": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "Additive": {
   "type": "object",
   "required": [
    "code",
    "name_th",
    "level"
   ],
   "properties": {
    "code": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "level": {
     "enum": [
      "info",
      "caution",
      "unknown"
     ]
    }
   }
  },
  "Battle": {
   "type": "object",
   "required": [
    "a",
    "b",
    "score_a",
    "score_b",
    "winner",
    "sugar_diff_tsp",
    "price_diff_thb"
   ],
   "properties": {
    "a": {
     "type": "string"
    },
    "b": {
     "type": "string"
    },
    "score_a": {
     "type": "integer"
    },
    "score_b": {
     "type": "integer"
    },
    "winner": {
     "type": "string"
    },
    "sugar_diff_tsp": {
     "type": "number",
     "minimum": 0
    },
    "price_diff_thb": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "Swap": {
   "type": [
    "object",
    "null"
   ],
   "required": [
    "from",
    "to",
    "score_gain",
    "sugar_saved_tsp"
   ],
   "properties": {
    "from": {
     "type": "string"
    },
    "to": {
     "type": "string"
    },
    "score_gain": {
     "type": "integer",
     "exclusiveMinimum": 0
    },
    "sugar_saved_tsp": {
     "type": "number"
    }
   }
  },
  "BudgetDay": {
   "type": "object",
   "required": [
    "totals",
    "pct",
    "over",
    "sugar_tsp",
    "items"
   ],
   "properties": {
    "totals": {
     "type": "object",
     "required": [
      "kcal",
      "sugar_g",
      "fat_g",
      "sodium_mg"
     ],
     "properties": {
      "kcal": {
       "type": "number",
       "minimum": 0
      },
      "sugar_g": {
       "type": "number",
       "minimum": 0
      },
      "fat_g": {
       "type": "number",
       "minimum": 0
      },
      "sodium_mg": {
       "type": "number",
       "minimum": 0
      }
     }
    },
    "pct": {
     "type": "object"
    },
    "over": {
     "type": "array",
     "items": {
      "enum": [
       "fat_g",
       "kcal",
       "sodium_mg",
       "sugar_g"
      ]
     }
    },
    "sugar_tsp": {
     "type": "number"
    },
    "items": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "Streak": {
   "type": "object",
   "required": [
    "streak",
    "badge"
   ],
   "properties": {
    "streak": {
     "type": "integer",
     "minimum": 0
    },
    "badge": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "ReelCard": {
   "type": "object",
   "required": [
    "kind",
    "title_th",
    "big_stat",
    "sub_th"
   ],
   "properties": {
    "kind": {
     "enum": [
      "sugar_spoons",
      "battle",
      "day_total",
      "swap",
      "streak"
     ]
    },
    "title_th": {
     "type": "string"
    },
    "big_stat": {
     "type": "string"
    },
    "sub_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   }
  }
 }
}