{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/inktry.schema.json",
 "title": "InkTry",
 "$defs": {
  "Person": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "age",
    "region"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 1
    },
    "city_th": {
     "type": "string"
    },
    "goal_th": {
     "type": "string"
    },
    "region": {
     "enum": [
      "bkk",
      "province",
      "tourist"
     ]
    }
   },
   "additionalProperties": false
  },
  "Detection": {
   "type": "object",
   "required": [
    "placement",
    "confidence"
   ],
   "properties": {
    "placement": {
     "enum": [
      "inner_forearm",
      "outer_forearm",
      "wrist",
      "upper_arm",
      "shoulder",
      "ankle",
      "calf",
      "thigh",
      "back",
      "nape",
      "ribs",
      "collarbone",
      "hand",
      "finger",
      "behind_ear"
     ]
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "side": {
     "enum": [
      "left",
      "right",
      "unknown"
     ]
    }
   },
   "additionalProperties": false
  },
  "SkinPhoto": {
   "type": "object",
   "required": [
    "id",
    "px_w",
    "px_h",
    "glare",
    "blur",
    "tilt",
    "skin_visible",
    "undertone",
    "detections"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^p[0-9]{2}$"
    },
    "px_w": {
     "type": "integer",
     "minimum": 1
    },
    "px_h": {
     "type": "integer",
     "minimum": 1
    },
    "glare": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "blur": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "tilt": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "skin_visible": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "undertone": {
     "enum": [
      "warm",
      "cool",
      "neutral"
     ]
    },
    "detections": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Detection"
     }
    }
   },
   "additionalProperties": false
  },
  "ScanQuality": {
   "type": "object",
   "required": [
    "score",
    "ok",
    "tips_th"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "ok": {
     "type": "boolean"
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "IdentifiedPlacement": {
   "type": "object",
   "required": [
    "placement",
    "name_th",
    "name_en",
    "confidence"
   ],
   "properties": {
    "placement": {
     "enum": [
      "inner_forearm",
      "outer_forearm",
      "wrist",
      "upper_arm",
      "shoulder",
