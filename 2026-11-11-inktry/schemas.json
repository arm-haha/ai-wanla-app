     "minimum": 0,
     "maximum": 1
    },
    "side": {
     "enum": [
      "left",
      "right",
      "unknown"
     ]
    }
   },
   "additionalProperties": false
  },
  "SkinScan": {
   "type": "object",
   "required": [
    "photo_id",
    "quality",
    "placements",
    "uncertain",
    "placement_count",
    "undertone"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "quality": {
     "$ref": "#/$defs/ScanQuality"
    },
    "placements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/IdentifiedPlacement"
     }
    },
    "uncertain": {
     "type": "array",
     "items": {
      "enum": [
       "inner_forearm",
       "outer_forearm",
       "wrist",
       "upper_arm",
       "shoulder",
       "ankle",
       "calf",
       "thigh",
       "back",
       "nape",
       "ribs",
       "collarbone",
       "hand",
       "finger",
       "behind_ear"
