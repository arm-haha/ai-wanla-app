{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "wattwise.schemas.json",
 "title": "WattWise schemas",
 "$defs": {
  "Home": {
   "type": "object",
   "required": [
    "name",
    "rate_thb_per_kwh"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "rate_thb_per_kwh": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "provider": {
     "enum": [
      "MEA",
      "PEA",
      "condo",
      "other"
     ]
    },
    "goal_thb": {
     "type": "number",
     "minimum": 0
    },
    "household_size": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "Appliance": {
   "type": "object",
   "required": [
    "id",
    "name_th"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string",
     "minLength": 1
    },
    "watt": {
     "type": "number",
     "minimum": 0
    },
    "hours_per_day": {
     "type": "number",
     "minimum": 0,
     "maximum": 24
    },
    "kwh_per_day": {
     "type": "number",
     "minimum": 0
    },
    "category": {
     "enum": [
      "cooling",
      "kitchen",
      "bath",
      "work",
      "entertain",
      "laundry",
      "other"
     ]
    },
    "room": {
     "type": "string"
    }
   },
   "anyOf": [
    {
     "required": [
      "watt",
      "hours_per_day"
     ]
    },
    {
     "required": [
      "kwh_per_day"
     ]
    }
   ]
  },
  "LabelExtract": {
   "type": "object",
   "required": [
    "name_th",
    "watt",
    "confidence",
    "needs_confirm"
   ],
   "properties": {
    "name_th": {
     "type": "string"
    },
    "watt": {
     "type": [
      "number",
      "null"
     ]
    },
    "btu": {
     "type": [
      "number",
      "null"
     ]
    },
    "energy_label_stars": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 5
    },
    "kwh_per_year": {
     "type": [
      "number",
      "null"
     ]
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "needs_confirm": {
     "type": "boolean"
    }
   }
  },
  "ApplianceCost": {
   "type": "object",
   "required": [
    "appliance_id",
    "kwh_month",
    "cost_month_thb",
    "cost_year_thb",
    "tier"
   ],
   "properties": {
    "appliance_id": {
     "type": "string"
    },
    "kwh_month": {
     "type": "number",
     "minimum": 0
    },
    "cost_month_thb": {
     "type": "number",
     "minimum": 0
    },
    "cost_year_thb": {
     "type": "number",
     "minimum": 0
    },
    "cost_per_hour_thb": {
     "type": [
      "number",
      "null"
     ]
    },
    "tier": {
     "enum": [
      "green",
      "amber",
      "red"
     ]
    }
   }
  },
  "Bill": {
   "type": "object",
   "required": [
    "month",
    "units_kwh",
    "total_thb"
   ],
   "properties": {
    "month": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}$"
    },
    "units_kwh": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "total_thb": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "BillExtract": {
   "type": "object",
   "required": [
    "units_kwh",
    "total_thb",
    "confidence",
    "needs_confirm"
   ],
   "properties": {
    "units_kwh": {
     "type": [
      "number",
      "null"
     ]
    },
    "total_thb": {
     "type": [
      "number",
      "null"
     ]
    },
    "period_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "meter_prev": {
     "type": [
      "number",
      "null"
     ]
    },
    "meter_now": {
     "type": [
      "number",
      "null"
     ]
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "needs_confirm": {
     "type": "boolean"
    }
   }
  },
  "Breakdown": {
   "type": "object",
   "required": [
    "bill_units",
    "bill_thb",
    "effective_rate",
    "estimated_kwh",
    "unexplained_kwh",
    "unexplained_pct",
    "over_estimated",
    "slices"
   ],
   "properties": {
    "bill_units": {
     "type": "number",
     "minimum": 0
    },
    "bill_thb": {
     "type": "number",
     "minimum": 0
    },
    "effective_rate": {
     "type": "number",
     "minimum": 0
    },
    "estimated_kwh": {
     "type": "number",
     "minimum": 0
    },
    "unexplained_kwh": {
     "type": "number",
     "minimum": 0
    },
    "unexplained_pct": {
     "type": "number",
     "minimum": 0
    },
    "over_estimated": {
     "type": "boolean"
    },
    "top_appliance_id": {
     "type": [
      "string",
      "null"
     ]
    },
    "slices": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "appliance_id",
       "kwh",
       "pct",
       "thb"
      ],
      "properties": {
       "appliance_id": {
        "type": "string"
       },
       "kwh": {
        "type": "number",
        "minimum": 0
       },
       "pct": {
        "type": "number",
        "minimum": 0
       },
       "thb": {
        "type": "number",
        "minimum": 0
       }
      }
     }
    }
   }
  },
  "AcSim": {
   "type": "object",
   "required": [
    "from_c",
    "to_c",
    "pct_per_deg",
    "base_cost_thb",
    "new_cost_thb",
    "save_month_thb",
    "save_year_thb",
    "assumption_th"
   ],
   "properties": {
    "from_c": {
     "type": "integer",
     "minimum": 16,
     "maximum": 30
    },
    "to_c": {
     "type": "integer",
     "minimum": 16,
     "maximum": 30
    },
    "pct_per_deg": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.3
    },
    "base_cost_thb": {
     "type": "number",
     "minimum": 0
    },
    "new_cost_thb": {
     "type": "number",
     "minimum": 0
    },
    "save_month_thb": {
     "type": "number"
    },
    "save_year_thb": {
     "type": "number"
    },
    "assumption_th": {
     "type": "string"
    }
   }
  },
  "StandbyItem": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "standby_watt"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "standby_watt": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "StandbyLeak": {
   "type": "object",
   "required": [
    "total_standby_watt",
    "kwh_month",
    "cost_month_thb",
    "cost_year_thb"
   ],
   "properties": {
    "total_standby_watt": {
     "type": "number",
     "minimum": 0
    },
    "kwh_month": {
     "type": "number",
     "minimum": 0
    },
    "cost_month_thb": {
     "type": "number",
     "minimum": 0
    },
    "cost_year_thb": {
     "type": "number",
     "minimum": 0
    },
    "worst_id": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "MeterReading": {
   "type": "object",
   "required": [
    "date",
    "meter_kwh"
   ],
   "properties": {
    "date": {
     "type": "string",
     "format": "date"
    },
    "meter_kwh": {
     "type": "number",
     "minimum": 0
    },
    "photo": {
     "type": "boolean"
    }
   }
  },
  "GoalTrack": {
   "type": "object",
   "required": [
    "used_kwh",
    "days",
    "per_day_kwh",
    "projected_kwh",
    "projected_thb",
    "goal_thb",
    "budget_per_day_kwh",
    "on_track",
    "gap_thb"
   ],
   "properties": {
    "used_kwh": {
     "type": "number",
     "minimum": 0
    },
    "days": {
     "type": "integer",
     "minimum": 1
    },
    "per_day_kwh": {
     "type": "number",
     "minimum": 0
    },
    "projected_kwh": {
     "type": "number",
     "minimum": 0
    },
    "projected_thb": {
     "type": "number",
     "minimum": 0
    },
    "goal_thb": {
     "type": "number",
     "minimum": 0
    },
    "budget_per_day_kwh": {
     "type": "number",
     "minimum": 0
    },
    "on_track": {
     "type": "boolean"
    },
    "gap_thb": {
     "type": "number"
    }
   }
  },
  "RoomShare": {
   "type": "object",
   "required": [
    "name",
    "kwh",
    "pct",
    "thb"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "kwh": {
     "type": "number",
     "minimum": 0
    },
    "pct": {
     "type": "number",
     "minimum": 0
    },
    "thb": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "SwapPayback": {
   "type": "object",
   "required": [
    "save_month_thb",
    "payback_months"
   ],
   "properties": {
    "save_month_thb": {
     "type": "number"
    },
    "payback_months": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "Tip": {
   "type": "object",
   "required": [
    "id",
    "title_th",
    "save_month_thb",
    "effort"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "title_th": {
     "type": "string"
    },
    "save_month_thb": {
     "type": "number",
     "minimum": 0
    },
    "effort": {
     "enum": [
      "easy",
      "medium",
      "hard"
     ]
    },
    "source": {
     "enum": [
      "ac_sim",
      "standby",
      "swap",
      "habit"
     ]
    }
   }
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "kind",
    "title_th",
    "big_stat",
    "sub_th"
   ],
   "properties": {
    "kind": {
     "enum": [
      "bill_pie",
      "ac_save",
      "standby",
      "goal",
      "split"
     ]
    },
    "title_th": {
     "type": "string"
    },
    "big_stat": {
     "type": "string"
    },
    "sub_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   }
  }
 }
}