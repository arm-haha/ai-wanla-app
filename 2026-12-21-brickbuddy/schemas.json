    "stars": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "badges": {
     "type": "array",
     "items": {
      "enum": [
       "rainbow",
       "symmetry_star",
       "sky_high",
       "challenge_done"
      ]
     }
    },
    "over_limit": {
     "type": "boolean"
    },
    "cheer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "DiaryEntry": {
   "type": "object",
   "required": [
    "date",
    "kind"
   ],
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "kind": {
     "enum": [
      "build",
      "challenge",
      "sort"
     ]
    },
    "build": {
     "enum": [
      "race_car",
      "duck",
      "house",
      "rocket",
      "robot",
      "dino",
      "phone_stand",
      "pencil_cup",
      "xmas_tree",
      "snowman",
      "ny_2027",
      "boat",
      "flower",
      "castle_tower"
     ]
    },
    "pieces": {
     "type": "integer",
     "minimum": 0
    },
    "stars": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "badges": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "DiarySummary": {
   "type": "object",
   "required": [
    "today",
    "builds",
    "challenges",
    "pieces_used",
    "streak",
    "best_stars",
    "badges"
   ],
   "properties": {
    "today": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "builds": {
     "type": "integer",
     "minimum": 0
    },
    "challenges": {
     "type": "integer",
     "minimum": 0
    },
    "pieces_used": {
     "type": "integer",
     "minimum": 0
    },
    "streak": {
     "type": "integer",
     "minimum": 0
    },
    "best_stars": {
     "type": "integer",
     "minimum": 0,
     "maximum": 5
    },
    "badges": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "ReelShot": {
   "type": "object",
   "required": [
    "kind",
    "start",
    "end",
    "caption_th"
   ],
   "properties": {
    "kind": {
     "enum": [
      "pile",
      "scan",
      "ideas",
      "steps",
      "reveal",
      "cta"
     ]
    },
    "start": {
     "type": "number",
     "minimum": 0
    },
    "end": {
     "type": "number"
    },
    "caption_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ReelPlan": {
   "type": "object",
   "required": [
    "build",
    "seconds",
    "ratio",
    "bpm",
    "shots",
    "watermark"
   ],
   "properties": {
    "build": {
     "type": "string"
    },
    "seconds": {
     "type": "integer",
     "minimum": 15,
     "maximum": 30
    },
    "ratio": {
     "const": "9:16"
    },
    "bpm": {
     "type": "integer",
     "minimum": 1
    },
    "shots": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ReelShot"
     },
     "minItems": 3
    },
    "watermark": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "name_th",
    "stars",
    "layout",
