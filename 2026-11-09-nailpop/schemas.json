{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/nailpop.schema.json",
 "title": "NailPop",
 "$defs": {
  "Person": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "age",
    "occasion",
    "budget_thb",
    "region",
    "quiz",
    "skin_rgb"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 1
    },
    "city_th": {
     "type": "string"
    },
    "goal_th": {
     "type": "string"
    },
    "occasion": {
     "enum": [
      "office",
      "wedding",
      "songkran",
      "loy_krathong",
      "date",
      "new_year"
     ]
    },
    "budget_thb": {
     "type": "integer",
     "minimum": 0
    },
    "region": {
     "enum": [
      "bkk",
      "province",
      "tourist"
     ]
    },
    "quiz": {
     "$ref": "#/$defs/UndertoneQuiz"
    },
    "skin_rgb": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
     },
     "minItems": 3,
     "maxItems": 3
    }
   },
   "additionalProperties": false
  },
  "UndertoneQuiz": {
   "type": "object",
   "required": [
    "vein",
    "jewelry",
    "sun"
   ],
   "properties": {
    "vein": {
     "enum": [
      "green",
      "blue",
      "mixed"
     ]
    },
    "jewelry": {
     "enum": [
      "gold",
      "silver",
      "both"
     ]
    },
    "sun": {
     "enum": [
      "tan",
      "burn",
      "both"
     ]
    }
   },
   "additionalProperties": false
  },
  "NailMeasure": {
   "type": "object",
   "required": [
    "finger",
    "width_mm",
    "bed_len_mm",
    "free_edge_mm",
    "taper",
    "corner_round"
   ],
   "properties": {
    "finger": {
     "enum": [
      "thumb",
      "index",
      "middle",
      "ring",
      "pinky"
     ]
    },
    "width_mm": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "bed_len_mm": {
     "type": "number",
     "minimum": 0
    },
    "free_edge_mm": {
     "type": "number",
     "minimum": 0
    },
    "taper": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "corner_round": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "HandPhoto": {
   "type": "object",
   "required": [
    "id",
    "hand",
    "px_w",
    "px_h",
    "lighting",
    "blur",
    "tilt",
    "nails"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^h[0-9]{2}$"
    },
    "hand": {
     "enum": [
      "left",
      "right"
     ]
    },
    "px_w": {
     "type": "integer",
     "minimum": 1
    },
    "px_h": {
     "type": "integer",
     "minimum": 1
    },
    "lighting": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "blur": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "tilt": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "nails": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/NailMeasure"
     },
     "minItems": 1,
     "maxItems": 5
    }
   },
   "additionalProperties": false
  },
  "NailDetect": {
   "type": "object",
   "required": [
    "finger",
    "shape",
    "shape_th",
    "length",
    "length_th",
    "width_mm",
    "total_len_mm"
   ],
   "properties": {
    "finger": {
     "enum": [
      "thumb",
      "index",
      "middle",
      "ring",
      "pinky"
     ]
    },
    "shape": {
     "enum": [
      "square",
      "squoval",
      "round",
      "oval",
      "almond",
      "coffin",
      "stiletto"
     ]
    },
    "shape_th": {
     "type": "string"
    },
    "length": {
     "enum": [
      "short",
      "medium",
      "long"
     ]
    },
    "length_th": {
     "type": "string"
    },
    "width_mm": {
     "type": "number",
     "minimum": 0
    },
    "total_len_mm": {
     "type": "number",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "ScanQuality": {
   "type": "object",
   "required": [
    "score",
    "ok",
    "tips_th"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "ok": {
     "type": "boolean"
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "HandScan": {
   "type": "object",
   "required": [
    "photo_id",
    "hand",
    "nail_count",
    "nails",
    "shape",
    "shape_th",
    "length",
    "length_th",
    "quality"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "hand": {
     "enum": [
      "left",
      "right"
     ]
    },
    "nail_count": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "nails": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/NailDetect"
     }
    },
    "shape": {
     "enum": [
      "square",
      "squoval",
      "round",
      "oval",
      "almond",
      "coffin",
      "stiletto"
     ]
    },
    "shape_th": {
     "type": "string"
    },
    "length": {
     "enum": [
      "short",
      "medium",
      "long"
     ]
    },
    "length_th": {
     "type": "string"
    },
    "quality": {
     "$ref": "#/$defs/ScanQuality"
    }
   },
   "additionalProperties": false
  },
  "UndertoneResult": {
   "type": "object",
   "required": [
    "undertone",
    "undertone_th",
    "depth",
    "points",
    "rgb_hint",
    "confidence"
   ],
   "properties": {
    "undertone": {
     "enum": [
      "warm",
      "cool",
      "neutral"
     ]
    },
    "undertone_th": {
     "type": "string"
    },
    "depth": {
     "enum": [
      "light",
      "medium",
      "tan",
      "deep"
     ]
    },
    "points": {
     "type": "object",
     "required": [
      "warm",
      "cool"
     ],
     "properties": {
      "warm": {
       "type": "integer",
       "minimum": 0
      },
      "cool": {
       "type": "integer",
       "minimum": 0
      }
     },
     "additionalProperties": false
    },
    "rgb_hint": {
     "enum": [
      "warm",
      "cool",
      "neutral"
     ]
    },
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "ShadeRec": {
   "type": "object",
   "required": [
    "undertone",
    "depth",
    "best",
    "avoid",
    "note_th"
   ],
   "properties": {
    "undertone": {
     "enum": [
      "warm",
      "cool",
      "neutral"
     ]
    },
    "depth": {
     "type": "string"
    },
    "best": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name_th",
       "hex"
      ],
      "properties": {
       "name_th": {
        "type": "string"
       },
       "hex": {
        "type": "string",
        "pattern": "^#[0-9A-F]{6}$"
       }
      },
      "additionalProperties": false
     },
     "minItems": 1
    },
    "avoid": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name_th",
       "hex"
      ],
      "properties": {
       "name_th": {
        "type": "string"
       },
       "hex": {
        "type": "string",
        "pattern": "^#[0-9A-F]{6}$"
       }
      },
      "additionalProperties": false
     }
    },
    "note_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Design": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "name_en",
    "technique",
    "finish",
    "art",
    "colors",
    "tones",
    "occasions",
    "len_min",
    "shapes"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^d[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "technique": {
     "enum": [
      "regular",
      "gel",
      "extension"
     ]
    },
    "finish": {
     "enum": [
      "glossy",
      "matte",
      "chrome",
      "cat_eye",
      "glitter",
      "pearl"
     ]
    },
    "art": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    },
    "colors": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
     },
     "minItems": 1
    },
    "tones": {
     "type": "array",
     "items": {
      "enum": [
       "warm",
       "cool",
       "neutral"
      ]
     },
     "minItems": 1
    },
    "occasions": {
     "type": "array",
     "items": {
      "enum": [
       "office",
       "wedding",
       "songkran",
       "loy_krathong",
       "date",
       "new_year"
      ]
     }
    },
    "len_min": {
     "enum": [
      "short",
      "medium",
      "long"
     ]
    },
    "shapes": {
     "type": "array",
     "items": {
      "enum": [
       "square",
       "squoval",
       "round",
       "oval",
       "almond",
       "coffin",
       "stiletto"
      ]
     },
     "minItems": 1
    }
   },
   "additionalProperties": false
  },
  "PriceEstimate": {
   "type": "object",
   "required": [
    "technique",
    "art_level",
    "length",
    "region",
    "removal",
    "min_thb",
    "max_thb",
    "disclaimer_th"
   ],
   "properties": {
    "technique": {
     "enum": [
      "regular",
      "gel",
      "extension"
     ]
    },
    "art_level": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    },
    "length": {
     "enum": [
      "short",
      "medium",
      "long"
     ]
    },
    "region": {
     "enum": [
      "bkk",
      "province",
      "tourist"
     ]
    },
    "removal": {
     "type": "boolean"
    },
    "min_thb": {
     "type": "integer",
     "minimum": 0
    },
    "max_thb": {
     "type": "integer",
     "minimum": 0
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "TryOnTile": {
   "type": "object",
   "required": [
    "rank",
    "slot",
    "design_id",
    "name_th",
    "colors",
    "finish",
    "technique",
    "fit_score",
    "price_min_thb",
    "price_max_thb",
    "why_th",
    "render"
   ],
   "properties": {
    "rank": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9
    },
    "slot": {
     "type": "string",
     "pattern": "^r[1-3]c[1-3]$"
    },
    "design_id": {
     "type": "string",
     "pattern": "^d[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "colors": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
     }
    },
    "finish": {
     "enum": [
      "glossy",
      "matte",
      "chrome",
      "cat_eye",
      "glitter",
      "pearl"
     ]
    },
    "technique": {
     "enum": [
      "regular",
      "gel",
      "extension"
     ]
    },
    "fit_score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "price_min_thb": {
     "type": "integer",
     "minimum": 0
    },
    "price_max_thb": {
     "type": "integer",
     "minimum": 0
    },
    "why_th": {
     "type": "string"
    },
    "render": {
     "const": "overlay_on_real_nails"
    }
   },
   "additionalProperties": false
  },
  "TryOnGrid": {
   "type": "object",
   "required": [
    "photo_id",
    "undertone",
    "occasion",
    "budget_thb",
    "count",
    "tiles",
    "watermark"
   ],
   "properties": {
    "photo_id": {
     "type": "string"
    },
    "undertone": {
     "enum": [
      "warm",
      "cool",
      "neutral"
     ]
    },
    "occasion": {
     "enum": [
      "office",
      "wedding",
      "songkran",
      "loy_krathong",
      "date",
      "new_year",
      null
     ]
    },
    "budget_thb": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "count": {
     "type": "integer",
     "minimum": 1,
     "maximum": 9
    },
    "tiles": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TryOnTile"
     },
     "minItems": 1,
     "maxItems": 9
    },
    "watermark": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "SalonCard": {
   "type": "object",
   "required": [
    "title_th",
    "name_th",
    "design_id",
    "design_name_th",
    "shape",
    "shape_th",
    "length",
    "length_th",
    "technique",
    "technique_th",
    "colors",
    "price_min_thb",
    "price_max_thb",
    "note_th",
    "share_text_th",
    "line_share_url",
    "disclaimer_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "design_id": {
     "type": "string",
     "pattern": "^d[0-9]{2}$"
    },
    "design_name_th": {
     "type": "string"
    },
    "shape": {
     "enum": [
      "square",
      "squoval",
      "round",
      "oval",
      "almond",
      "coffin",
      "stiletto"
     ]
    },
    "shape_th": {
     "type": "string"
    },
    "length": {
     "enum": [
      "short",
      "medium",
      "long"
     ]
    },
    "length_th": {
     "type": "string"
    },
    "technique": {
     "enum": [
      "regular",
      "gel",
      "extension"
     ]
    },
    "technique_th": {
     "type": "string"
    },
    "colors": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
     }
    },
    "price_min_thb": {
     "type": "integer",
     "minimum": 0
    },
    "price_max_thb": {
     "type": "integer",
     "minimum": 0
    },
    "note_th": {
     "type": "string"
    },
    "share_text_th": {
     "type": "string"
    },
    "line_share_url": {
     "type": "string",
     "pattern": "^https://line\\.me/R/share\\?text="
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "VoteLink": {
   "type": "object",
   "required": [
    "grid_id",
    "options",
    "url",
    "expires_hours",
    "anonymous"
   ],
   "properties": {
    "grid_id": {
     "type": "string"
    },
    "options": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^d[0-9]{2}$"
     },
     "minItems": 2,
     "maxItems": 4
    },
    "url": {
     "type": "string",
     "pattern": "^https://"
    },
    "expires_hours": {
     "type": "integer",
     "minimum": 1
    },
    "anonymous": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "VoteResult": {
   "type": "object",
   "required": [
    "total",
    "invalid",
    "winner",
    "winner_pct",
    "results"
   ],
   "properties": {
    "total": {
     "type": "integer",
     "minimum": 0
    },
    "invalid": {
     "type": "integer",
     "minimum": 0
    },
    "winner": {
     "type": [
      "string",
      "null"
     ]
    },
    "winner_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "results": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "design_id",
       "votes",
       "pct"
      ],
      "properties": {
       "design_id": {
        "type": "string",
        "pattern": "^d[0-9]{2}$"
       },
       "votes": {
        "type": "integer",
        "minimum": 1
       },
       "pct": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
       }
      },
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": false
  },
  "CareReminder": {
   "type": "object",
   "required": [
    "technique",
    "done_date",
    "check_date",
    "due_date",
    "remove_by",
    "message_th"
   ],
   "properties": {
    "technique": {
     "enum": [
      "regular",
      "gel",
      "extension"
     ]
    },
    "done_date": {
     "type": "string",
     "format": "date",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "check_date": {
     "type": "string",
     "format": "date",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "due_date": {
     "type": "string",
     "format": "date",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "remove_by": {
     "type": "string",
     "format": "date",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ReminderStatus": {
   "type": "object",
   "required": [
    "status",
    "days_since",
    "days_to_due"
   ],
   "properties": {
    "status": {
     "enum": [
      "ok",
      "check",
      "due",
      "overdue"
     ]
    },
    "days_since": {
     "type": "integer"
    },
    "days_to_due": {
     "type": "integer"
    }
   },
   "additionalProperties": false
  },
  "DiaryEntry": {
   "type": "object",
   "required": [
    "id",
    "date",
    "design_id",
    "technique",
    "price_thb",
    "rating",
    "salon_th",
    "on_device",
    "reminder"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "date": {
     "type": "string",
     "format": "date",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "design_id": {
     "type": "string",
     "pattern": "^d[0-9]{2}$"
    },
    "technique": {
     "enum": [
      "regular",
      "gel",
      "extension"
     ]
    },
    "price_thb": {
     "type": "integer",
     "minimum": 0
    },
    "rating": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "salon_th": {
     "type": "string"
    },
    "on_device": {
     "type": "boolean"
    },
    "reminder": {
     "$ref": "#/$defs/CareReminder"
    }
   },
   "additionalProperties": false
  },
  "DiaryStats": {
   "type": "object",
   "required": [
    "count",
    "total_thb",
    "avg_thb",
    "avg_rating",
    "favorite_design"
   ],
   "properties": {
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "total_thb": {
     "type": "integer",
     "minimum": 0
    },
    "avg_thb": {
     "type": "integer",
     "minimum": 0
    },
    "avg_rating": {
     "type": "number",
     "minimum": 0,
     "maximum": 5
    },
    "favorite_design": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "OccasionPreset": {
   "type": "object",
   "required": [
    "key",
    "label_th",
    "tip_th",
    "palette",
    "max_length",
    "design_ids"
   ],
   "properties": {
    "key": {
