{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/phonerescue.schema.json",
 "title": "PhoneRescue",
 "$defs": {
  "Person": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "age"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 1
    },
    "city_th": {
     "type": "string"
    },
    "goal_th": {
     "type": "string"
    },
    "device_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Detection": {
   "type": "object",
   "required": [
    "key",
    "value",
    "confidence"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "value": true,
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "Screenshot": {
   "type": "object",
   "required": [
    "id",
    "px_w",
    "px_h",
    "glare",
    "blur",
    "crop",
    "detections"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^s[0-9]{2}$"
    },
    "px_w": {
     "type": "integer",
     "minimum": 1
    },
    "px_h": {
     "type": "integer",
     "minimum": 1
    },
    "glare": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "blur": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "crop": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "detections": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Detection"
     }
    }
   },
   "additionalProperties": false
  },
  "ScanQuality": {
   "type": "object",
   "required": [
    "score",
    "ok",
    "tips_th"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "ok": {
     "type": "boolean"
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "StorageScan": {
   "type": "object",
   "required": [
    "shot_id",
    "quality",
    "ok",
    "used_gb",
    "total_gb",
    "free_gb",
    "percent",
    "breakdown",
    "message_th"
   ],
   "properties": {
    "shot_id": {
     "type": "string"
    },
    "quality": {
     "$ref": "#/$defs/ScanQuality"
    },
    "ok": {
     "type": "boolean"
    },
    "used_gb": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "total_gb": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "free_gb": {
     "type": [
      "number",
      "null"
     ]
    },
    "percent": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "breakdown": {
     "type": "object",
     "additionalProperties": {
      "type": "number",
      "minimum": 0
     }
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "BatteryScan": {
   "type": "object",
   "required": [
    "shot_id",
    "quality",
    "ok",
    "health_pct",
    "screen_on_h",
    "last_charge_h",
    "brightness_pct",
    "background_refresh",
    "low_power",
    "message_th"
   ],
   "properties": {
    "shot_id": {
     "type": "string"
    },
    "quality": {
     "$ref": "#/$defs/ScanQuality"
    },
    "ok": {
     "type": "boolean"
    },
    "health_pct": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "screen_on_h": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "last_charge_h": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "brightness_pct": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "background_refresh": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "low_power": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Pipeline": {
   "type": "object",
   "required": [
    "shot_id",
    "steps"
   ],
   "properties": {
    "shot_id": {
     "type": "string"
    },
    "steps": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    }
   },
   "additionalProperties": false
  },
  "CleanupAction": {
   "type": "object",
   "required": [
    "id",
    "key",
    "name_th",
    "gb",
    "priority",
    "how_th",
    "n"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "key": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "gb": {
     "type": "number",
     "minimum": 0
    },
    "priority": {
     "type": "integer",
     "minimum": 1
    },
    "how_th": {
     "type": "string"
    },
    "n": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "CleanupPlan": {
   "type": "object",
   "required": [
    "used_gb",
    "total_gb",
    "free_gb",
    "saved_gb",
    "after_used_gb",
    "after_free_gb",
    "actions",
    "count",
    "headline_th"
   ],
   "properties": {
    "used_gb": {
     "type": "number",
     "minimum": 0
    },
    "total_gb": {
     "type": "number",
     "minimum": 0
    },
    "free_gb": {
     "type": "number",
     "minimum": 0
    },
    "saved_gb": {
     "type": "number",
     "minimum": 0
    },
    "after_used_gb": {
     "type": "number",
     "minimum": 0
    },
    "after_free_gb": {
     "type": "number",
     "minimum": 0
    },
    "actions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CleanupAction"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "GuideStep": {
   "type": "object",
   "required": [
    "n",
    "text_th"
   ],
   "properties": {
    "n": {
     "type": "integer",
     "minimum": 1
    },
    "text_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "DuplicateGuide": {
   "type": "object",
   "required": [
    "title_th",
    "steps",
    "disclaimer_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "steps": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/GuideStep"
     },
     "minItems": 1
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "BatteryTips": {
   "type": "object",
   "required": [
    "health_pct",
    "keys",
    "tips_th",
    "count",
    "headline_th"
   ],
   "properties": {
    "health_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "keys": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "RepairCheck": {
   "type": "object",
   "required": [
    "verdict",
    "message_th",
    "health_pct",
    "free_gb",
    "battery_min_thb",
    "battery_max_thb",
    "phone_min_thb",
    "phone_max_thb",
    "disclaimer_th"
   ],
   "properties": {
    "verdict": {
     "enum": [
      "cleanup",
      "cleanup_then_watch",
      "repair_battery",
      "replace_or_repair",
      "watch"
     ]
    },
    "message_th": {
     "type": "string"
    },
    "health_pct": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "free_gb": {
     "type": "number",
     "minimum": 0
    },
    "battery_min_thb": {
     "type": "integer",
     "minimum": 0
    },
    "battery_max_thb": {
     "type": "integer",
     "minimum": 0
    },
    "phone_min_thb": {
     "type": "integer",
     "minimum": 0
    },
    "phone_max_thb": {
     "type": "integer",
     "minimum": 0
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "title_th",
    "headline_th",
    "hook_th",
    "used_gb",
    "total_gb",
    "saved_gb",
    "health_pct",
    "layout",
    "sizes",
    "watermark",
    "cta_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "hook_th": {
     "type": "string"
    },
    "used_gb": {
     "type": "number",
     "minimum": 0
    },
    "total_gb": {
     "type": "number",
     "minimum": 0
    },
    "saved_gb": {
     "type": "number",
     "minimum": 0
    },
    "health_pct": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 100
    },
    "layout": {
     "enum": [
      "rescue_card"
     ]
    },
    "sizes": {
     "type": "array",
     "items": {
      "enum": [
       "1080x1350",
       "1080x1920",
       "1080x1080"
      ]
     }
    },
    "watermark": {
     "type": "string"
    },
    "cta_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "allowed",
    "left_after",
    "paywall"
   ],
   "properties": {
    "allowed": {
     "type": "integer",
     "minimum": 0
    },
    "left_after": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "paywall": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "SafetyGuard": {
   "type": "object",
   "required": [
    "level",
    "message_th"
   ],
   "properties": {
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 }
}