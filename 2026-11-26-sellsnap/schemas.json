{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://example.com/sellsnap.schema.json",
 "title": "SellSnap",
 "$defs": {
  "Person": {
   "type": "object",
   "required": [
    "id",
    "name_th",
    "age"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^u[0-9]{2}$"
    },
    "name_th": {
     "type": "string"
    },
    "name_en": {
     "type": "string"
    },
    "age": {
     "type": "integer",
     "minimum": 1
    },
    "city_th": {
     "type": "string"
    },
    "goal_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Detection": {
   "type": "object",
   "required": [
    "key",
    "value",
    "confidence"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "value": true,
    "confidence": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   },
   "additionalProperties": false
  },
  "ItemPhoto": {
   "type": "object",
   "required": [
    "id",
    "px_w",
    "px_h",
    "glare",
    "blur",
    "crop",
    "detections"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^s[0-9]{2}$"
    },
    "px_w": {
     "type": "integer",
     "minimum": 1
    },
    "px_h": {
     "type": "integer",
     "minimum": 1
    },
    "glare": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "blur": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "crop": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "detections": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Detection"
     }
    }
   },
   "additionalProperties": false
  },
  "ScanQuality": {
   "type": "object",
   "required": [
    "score",
    "ok",
    "tips_th"
   ],
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "ok": {
     "type": "boolean"
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "ItemScan": {
   "type": "object",
   "required": [
    "shot_id",
    "quality",
    "ok",
    "category",
    "item_th",
    "color_th",
    "brand_th",
    "defect_th",
    "message_th"
   ],
   "properties": {
    "shot_id": {
     "type": "string"
    },
    "quality": {
     "$ref": "#/$defs/ScanQuality"
    },
    "ok": {
     "type": "boolean"
    },
    "category": {
     "type": [
      "string",
      "null"
     ]
    },
    "item_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "color_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "brand_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "defect_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "message_th": {
     "type": "string"
    },
    "category_name_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ConditionGrade": {
   "type": "object",
   "required": [
    "ok",
    "condition",
    "grade",
    "name_th",
    "message_th"
   ],
   "properties": {
    "ok": {
     "type": "boolean"
    },
    "condition": {
     "type": [
      "string",
      "null"
     ]
    },
    "grade": {
     "type": [
      "string",
      "null"
     ]
    },
    "name_th": {
     "type": [
      "string",
      "null"
     ]
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "PriceRange": {
   "type": "object",
   "required": [
    "min_thb",
    "max_thb",
    "mid_thb",
    "category",
    "condition",
    "grade",
    "headline_th",
    "disclaimer_th"
   ],
   "properties": {
    "min_thb": {
     "type": "integer",
     "minimum": 0
    },
    "max_thb": {
     "type": "integer",
     "minimum": 0
    },
    "mid_thb": {
     "type": "integer",
     "minimum": 0
    },
    "category": {
     "type": "string"
    },
    "condition": {
     "type": "string"
    },
    "grade": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "disclaimer_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Listing": {
   "type": "object",
   "required": [
    "title_th",
    "description_th",
    "item_th",
    "condition",
    "grade",
    "min_thb",
    "max_thb",
    "ask_thb",
    "headline_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "description_th": {
     "type": "string"
    },
    "item_th": {
     "type": "string"
    },
    "condition": {
     "type": "string"
    },
    "grade": {
     "type": "string"
    },
    "min_thb": {
     "type": "integer",
     "minimum": 0
    },
    "max_thb": {
     "type": "integer",
     "minimum": 0
    },
    "ask_thb": {
     "type": "integer",
     "minimum": 0
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "PhotoTips": {
   "type": "object",
   "required": [
    "keys",
    "tips_th",
    "count",
    "headline_th"
   ],
   "properties": {
    "keys": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "tips_th": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ReplyTemplate": {
   "type": "object",
   "required": [
    "id",
    "key",
    "name_th",
    "text_th"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "key": {
     "type": "string"
    },
    "name_th": {
     "type": "string"
    },
    "text_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ReplyKit": {
   "type": "object",
   "required": [
    "ask_thb",
    "templates",
    "count"
   ],
   "properties": {
    "ask_thb": {
     "type": "integer",
     "minimum": 0
    },
    "templates": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ReplyTemplate"
     }
    },
    "count": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "LogRow": {
   "type": "object",
   "required": [
    "id",
    "status",
    "ask_thb",
    "sold_thb",
    "date",
    "title_th"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "status": {
     "enum": [
      "for_sale",
      "reserved",
      "sold"
     ]
    },
    "ask_thb": {
     "type": "integer",
     "minimum": 0
    },
    "sold_thb": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "date": {
     "type": [
      "string",
      "null"
     ]
    },
    "title_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "SoldLog": {
   "type": "object",
   "required": [
    "rows",
    "sold_count",
    "open_count",
    "reserved_count",
    "total_sold_thb",
    "headline_th"
   ],
   "properties": {
    "rows": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/LogRow"
     }
    },
    "sold_count": {
     "type": "integer",
     "minimum": 0
    },
    "open_count": {
     "type": "integer",
     "minimum": 0
    },
    "reserved_count": {
     "type": "integer",
     "minimum": 0
    },
    "total_sold_thb": {
     "type": "integer",
     "minimum": 0
    },
    "headline_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "ShareCard": {
   "type": "object",
   "required": [
    "title_th",
    "headline_th",
    "hook_th",
    "min_thb",
    "max_thb",
    "ask_thb",
    "grade",
    "layout",
    "sizes",
    "watermark",
    "cta_th"
   ],
   "properties": {
    "title_th": {
     "type": "string"
    },
    "headline_th": {
     "type": "string"
    },
    "hook_th": {
     "type": "string"
    },
    "min_thb": {
     "type": "integer",
     "minimum": 0
    },
    "max_thb": {
     "type": "integer",
     "minimum": 0
    },
    "ask_thb": {
     "type": "integer",
     "minimum": 0
    },
    "grade": {
     "type": "string"
    },
    "layout": {
     "enum": [
      "listing_card"
     ]
    },
    "sizes": {
     "type": "array",
     "items": {
      "enum": [
       "1080x1350",
       "1080x1920",
       "1080x1080"
      ]
     }
    },
    "watermark": {
     "type": "string"
    },
    "cta_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "Quota": {
   "type": "object",
   "required": [
    "allowed",
    "left_after",
    "paywall"
   ],
   "properties": {
    "allowed": {
     "type": "integer",
     "minimum": 0
    },
    "left_after": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "paywall": {
     "type": "boolean"
    }
   },
   "additionalProperties": false
  },
  "SafetyGuard": {
   "type": "object",
   "required": [
    "level",
    "message_th"
   ],
   "properties": {
    "level": {
     "enum": [
      "ok",
      "warn",
      "stop"
     ]
    },
    "message_th": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 }
}